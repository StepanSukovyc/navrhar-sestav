<?xml version="1.0" ?>
<!-- syntaxdefinition for GCS (varianta .cs) by Martin Aliger -->
<SyntaxDefinition name = "G-C#" extensions = ".gcs" extends="C#">

  <RuleSets>

    <RuleSet name="SqlSet" reference="G-SQL" />

    <RuleSet>

      <Span name = "Select" stopateol = "false" rule = "SqlSet">
        <Begin bold="true" italic="false" color="Green" bgcolor="#C0C0FF">#SELECT@!1@</Begin>
        <End bold="true" italic="false" color="Green" bgcolor="#C0C0FF">;;</End>
      </Span>

      <Span name = "Select" stopateol = "false" rule = "SqlSet">
        <Begin bold="true" italic="false" color="Green" bgcolor="#FFFFA0">#SELECT1</Begin>
        <End bold="true" italic="false" color="Green" bgcolor="#FFFFA0">;;</End>
      </Span>

    </RuleSet>

  </RuleSets>
</SyntaxDefinition>
