<?xml version="1.0"?>
<!-- syntaxdefinition for SQL+Placeholdery by Martin Aliger  -->

<SyntaxDefinition name = "G-SQL" extensions = ".SQL" extends="SQL">

	<RuleSets>
    <RuleSet>

      <Span name = "LineComment" rule = "CommentMarkerSet" bold = "false" italic = "false" color = "Green" stopateol = "true">
        <Begin>//</Begin>
      </Span>

    </RuleSet>
	</RuleSets>
</SyntaxDefinition>
