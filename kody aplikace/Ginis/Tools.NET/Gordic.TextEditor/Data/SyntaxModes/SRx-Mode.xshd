<?xml version="1.0"?>
<!-- syntaxdefinition for SRx  -->

<SyntaxDefinition name = "SRx" extensions = ".SR*"> 
	
	<Properties>
		<Property name="LineComment" value="//"/>
	</Properties>
	
	
  <Digits name = "Digits" bold = "false" italic = "false" color = "DarkBlue"/>

	<RuleSets>
		<RuleSet ignorecase="true">
			<Delimiters>&amp;&lt;&gt;~!%^*()-+=|\#/{}[]:;"' ,	.?</Delimiters>

			<Span name = "LineComment" rule = "CommentMarkerSet" bold = "false" italic = "false" color = "Blue" stopateol = "true">
			   	<Begin>//@!/@</Begin>
		  	</Span>
			
			<Span name = "BlockComment" rule = "CommentMarkerSet" bold = "false" italic = "false" color = "Blue" stopateol = "false">
				<Begin>/*</Begin>
				<End>*/</End>
			</Span>
		  	
			<Span name = "String" bold = "false" italic = "false" color = "Brown" stopateol = "true">
				<Begin>"</Begin>
				<End>"</End>
			</Span>
			
			<Span name = "String2" bold = "true" italic = "false" color = "Brown" stopateol = "true">
				<Begin>&apos;</Begin>
				<End>&apos;</End>
			</Span>

      <MarkPrevious bold = "false" italic = "false" color = "Black">(</MarkPrevious>

      <MarkPrevious bold = "false" italic = "false" color = "DarkBlue">!</MarkPrevious>

      <KeyWords name = "Enumeration" bold = "false" italic = "false" color = "DarkBlue">
        <Key word = "!" />
      </KeyWords>      
      
      <KeyWords name = "AccessKeywords" bold="false" italic="false" color="Green">
        <Key word = "this" />
        <Key word = "super" />
      </KeyWords>

      <KeyWords name = "Punctuation" bold = "false" italic = "false" color = "Black">
				<Key word = "?" />
				<Key word = "," />
				<Key word = "." />
				<Key word = ";" />
				<Key word = "(" />
				<Key word = ")" />
				<Key word = "[" />
				<Key word = "]" />
				<Key word = "{" />
				<Key word = "}" />
				<Key word = "+" />
				<Key word = "-" />
				<Key word = "/" />
				<Key word = "%" />
				<Key word = "*" />
				<Key word = "&lt;" />
				<Key word = "&gt;" />
				<Key word = "^" />
				<Key word = "=" />
				<Key word = "~" />
				<Key word = "!" />
				<Key word = "|" />
			    <Key word = "&amp;" />
		  	</KeyWords>

      <KeyWords name = "OperatorKeywords" bold="false" italic="false" color="Green">
        <Key word = "create" />
        <Key word = "true" />
        <Key word = "false" />
        <Key word = "destroy" />
      </KeyWords>      
      
      <KeyWords name = "SelectionStatements" bold="false" italic="false" color="Green">
        <Key word = "else" />
        <Key word = "if" />
        <Key word = "switch" />
        <Key word = "case" />
        <Key word = "default" />
        <Key word = "elseif" />
        <Key word = "end" />
        <Key word = "then" />
        <Key word = "choose" />
      </KeyWords>

      <KeyWords name = "IterationStatements" bold="false" italic="false" color="Green">
        <Key word = "do" />
        <Key word = "for" />
        <Key word = "foreach" />
        <Key word = "in" />
        <Key word = "while" />
        <Key word = "next" />
        <Key word = "on" />
      </KeyWords>

      <KeyWords name = "JumpStatements" bold="false" italic="false" color="Green">
        <Key word = "exit" />
        <Key word = "continue" />
        <Key word = "goto" />
        <Key word = "return" />
        <Key word = "call" />
      </KeyWords>

      <KeyWords name = "ValueTypes" bold="false" italic="false" color="Magenta">
        <Key word = "string" />
        <Key word = "long" />
        <Key word = "int" />
        <Key word = "integer" />
        <Key word = "decimal" />
        <Key word = "double" />
        <Key word = "datetime" />
        <Key word = "date" />
        <Key word = "time" />
        <Key word = "boolean" />
        <Key word = "ulong" />
        <Key word = "uint" />
      </KeyWords>

      <KeyWords name = "AccessKeywords" bold="false" italic="false" color="Green">
        <Key word = "OUTER" />
        <Key word = "AND" />
        <Key word = "ANY" />
        <Key word = "BETWEEN" />
        <Key word = "EXISTS" />
        <Key word = "IN" />
        <Key word = "JOIN" />
        <Key word = "LIKE" />
        <Key word = "NOT" />
        <Key word = "IS" />
        <Key word = "NULL" />
        <Key word = "OR" />
      </KeyWords>

      <KeyWords name = "AccessModifiers" bold="false" italic="false" color="Green">
        <Key word = "public" />
        <Key word = "protected" />
        <Key word = "private" />
        <Key word = "internal" />
        <Key word = "constant" />
        <Key word = "function" />
        <Key word = "prototypes" />
        <Key word = "variables" />
        <Key word = "forward" />
        <Key word = "type" />
        <Key word = "global" />
        <Key word = "within" />
        <Key word = "event" />
      </KeyWords>


      <KeyWords name = "OperatorKeywords" bold="false" italic="false" color="Magenta">
				<Key word = "COUNT" />
			</KeyWords>
			
			<!--KeyWords name = "SelectionStatements" bold="true" italic="false" color="Blue"-->
			<KeyWords name = "ReservredWords" bold="false" italic="false" color="Green">
        
				<Key word = "USING" />
        <Key word = "SELECT" />
        <Key word = "INSERT" />
        <Key word = "DELETE" />
        <Key word = "FROM" />
        <Key word = "WHERE" />
        <Key word = "INTO" />

      </KeyWords>
			
			<!-- KeyWords name = "SystemTables" bold="false" italic="false" color="Teal">
			</KeyWords -->
		</RuleSet>

    <RuleSet name = "CommentMarkerSet" ignorecase = "true">
      <Delimiters>&lt;&gt;~!@%^*()-+=|\#/{}[]:;"' ,	.?</Delimiters>
    </RuleSet>


  </RuleSets>
</SyntaxDefinition>
