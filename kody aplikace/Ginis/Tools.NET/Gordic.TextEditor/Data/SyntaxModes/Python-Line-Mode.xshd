<?xml version="1.0"?>
<!-- syntaxdefinition for Python 2010 Stepan Sukovych -->

<SyntaxDefinition name ="PythonLine" extensions = ".py">
  <Digits name="Digits" bold="false" italic="false" color="Green"/>

  <RuleSets>
    <RuleSet ignorecase="false">
      <Delimiters>~!%^*()-+=|\#/{}[]:;"'&lt;&gt;,.?</Delimiters>

      <!--Mezí dvojitými uvozovkami taky jiné zvýraznění-->
      <Span name ="STRING" bold ="false" italic ="false" color ="Sienna" stopateol ="false" >
        <Begin>&quot;</Begin>
        <End>&quot;</End>
      </Span>

      <!--Vše co v uvozovkách – zvýrazníme-->
      <Span name = "CHAR" bold = "false" italic = "false" color = "Sienna" stopateol = "true" >
        <Begin>&apos;</Begin>
        <End>&apos;</End>
      </Span>

      <!--Definice metody-->
      <Span name="METHOD" rule="MetodSet" bold = "true" italic = "false" color = "Blue" stopateol = "true">
        <Begin>def</Begin>
        <End>:</End>
      </Span>

      <!--Definice metody-->
      <Span name="CharecterReference" bold = "false" italic = "true" color = "Orange" stopateol = "true">
        <Begin>&amp;</Begin>
        <End>;</End>
      </Span>


      <!--Před závorkou jiné zvýraznění-->
      <MarkPrevious bold = "true" italic = "false" color = "MidnightBlue">(</MarkPrevious>

      <!--Punktaci zobrazíme červeně-->
      <KeyWords name = "Punctuation" bold = "false" italic = "false" color = "Chocolate">
        <Key word = "=" />
        <Key word = ";" />
        <Key word = "?" />
        <Key word = "," />
        <Key word = "." />
        <Key word = "(" />
        <Key word = ")" />
        <Key word = "[" />
        <Key word = "]" />
        <Key word = "{" />
        <Key word = "}" />
        <Key word = "+" />
        <Key word = "-" />
        <Key word = "/" />
        <Key word = "%" />
        <Key word = "*" />
        <Key word = "&lt;" />
        <Key word = "&gt;" />
        <Key word = "^" />
        <Key word = "!" />
        <Key word = "|" />
      </KeyWords>

      <!--Jazyk PYTHON-->
      <KeyWords name="Tags" bold="true" italic="false" color="Blue">
        <Key word="and" />
        <Key word="as" />
        <Key word="assert" />
        <Key word="break" />
        <Key word="class" />
        <Key word="continue" />
        <Key word="del" />
        <Key word="elif" />
        <Key word="else" />
        <Key word="except" />
        <Key word="exec" />
        <Key word="finally" />
        <Key word="for" />
        <Key word="from" />
        <Key word="global" />
        <Key word="if" />
        <Key word="import" />
        <Key word="in" />
        <Key word="is" />
        <Key word="lambda" />
        <Key word="None" />
        <Key word="not" />
        <Key word="or" />
        <Key word="pass" />
        <Key word="print" />
        <Key word="raise" />
        <Key word="return" />
        <Key word="try" />
        <Key word="while" />
        <Key word="with" />
        <Key word="yield" />
      </KeyWords>
    </RuleSet>
    
    <RuleSet name="MetodSet" ignorecase="false">
      <Delimiters>(),:</Delimiters>

      <!--Před závorkou jiné zvýraznění-->
      <MarkPrevious bold = "true" italic = "false" color = "MidnightBlue">(</MarkPrevious>

      <!--Před závorkou jiné zvýraznění-->
      <MarkPrevious bold = "false" italic = "false" color = "Green">)</MarkPrevious>

      <!--Před čárkou jiné zvýraznění-->
      <MarkPrevious bold = "false" italic = "false" color = "Green">,</MarkPrevious>

      <!--Za čárkou jiné zvýraznění-->
      <MarkFollowing bold = "false" italic = "false" color = "Green">,</MarkFollowing>

      <!--Punktaci zobrazíme červeně-->
      <KeyWords name = "Punctuation" bold = "false" italic = "false" color = "Chocolate">
        <Key word = "," />
        <Key word = "(" />
        <Key word = ")" />
      </KeyWords>

      <!--Jazyk PYTHON-->
      <KeyWords name="Tags" bold="true" italic="false" color="Blue">
        <Key word="def" />
      </KeyWords>

    </RuleSet>

  </RuleSets>
</SyntaxDefinition>