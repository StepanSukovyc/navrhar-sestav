<?xml version="1.0" ?>

<!-- syntaxdefinition for ALF 2009 by Stepan Sukovych -->

<SyntaxDefinition name = "ALF-GRR" extensions = ".alf" >
  <Properties>
    <Property name="BlockCommentBegin" value="&lt;!--"/>
    <Property name="BlockCommentEnd" value="--&gt;"/>
  </Properties>

  <Digits   name = "Digits"   bold = "false" italic = "false" color = "DarkBlue"/>
  
  <RuleSets>
    
    <RuleSet ignorecase = "true">
      
      <!--Skripty jsou napsané v jazyce PYTHON-->
      <Span name="ScriptTag" rule="PythonSet" bold="false" italic="false" color="Green" stopateol="false">
        <Begin color="DarkMagenta" bold="true">&lt;script&gt;</Begin>
        <End color="DarkMagenta" bold="true">&lt;/script&gt;</End>
      </Span>

      <Span name="Comment" bold="false" italic="true" color="DarkSlateGray" stopateol="false">
        <Begin>&lt;!--</Begin>
        <End>--&gt;</End>
      </Span>
      
      <Span name="AlfTagXml" rule="AlfTagSet" bold="false" italic="false" color="DarkMagenta" stopateol="false">
        <Begin>&lt;?</Begin>
        <End>?&gt;</End>
      </Span>

      <Span name="AlfTag" rule="AlfTagSet" bold="false" italic="false" color="DarkMagenta" stopateol="false">
        <Begin>&lt;</Begin>
        <End>&gt;</End>
      </Span>

    </RuleSet>

    <RuleSet name="PythonSet" reference="Python" />
    <RuleSet name="PythonLineSet" reference="PythonLine" />

    <RuleSet name="AlfTagSet" ignorecase="false" >
      <Delimiters>/=</Delimiters>

      <Span name="String" bold="false" italic="false" color="Blue" stopateol="true" >
        <Begin color="Black">&quot;</Begin>
        <End color="Black">&quot;</End>
      </Span>

      <Span name="Char" bold="false" italic="false" color="Blue" stopateol="true">
        <Begin color="Black">&apos;</Begin>
        <End color="Black">&apos;</End>
      </Span>

      <!--Skript onData-->
      <Span name="onData" rule="PythonLineSet" bold="false" italic="false" color="Green" stopateol="true" >
        <Begin color="Black">onData=&quot;</Begin>
        <End color="Black">&quot;</End>
      </Span>

      <!--Skript onLoad-->
      <Span name="onLoad" rule="PythonLineSet" bold="false" italic="false" color="Green" stopateol="false">
        <Begin color="Black" >onLoad=&quot;</Begin>
        <End color="Black" >&quot;</End>
      </Span>

      <!--Skript onEnter-->
      <Span name="onEnter" rule="PythonLineSet" bold="false" italic="false" color="Green" stopateol="false">
        <Begin color="Black" >onEnter=&quot;</Begin>
        <End color="Black" >&quot;</End>
      </Span>

      <!--Skript onPrint-->
      <Span name="onPrint" rule="PythonLineSet" bold="false" italic="false" color="Green" stopateol="false">
        <Begin color="Black" >onPrint=&quot;</Begin>
        <End color="Black" >&quot;</End>
      </Span>

      <MarkPrevious bold="false" italic="false" color="Red">=</MarkPrevious>

      <KeyWords name="Slash" bold="false" italic="false" color="DarkMagenta">
        <Key word="/"/>
      </KeyWords>

      <KeyWords name="Assignment" bold="true" italic="false" color="Black">
        <Key word="="/>
      </KeyWords>

      <KeyWords name = "Tags" bold="true" italic="false" color="DarkBlue">
        <Key word="format" />
        <Key word="xml" />
        <Key word ="info" />
        <Key word="region" />
        <Key word="head" />
        <Key word="body" />
        <Key word="foot" />
        <Key word="variable" />
        <Key word="paper-setting" />

        <Key word="table" />
        <Key word="line" />

        <Key word="value-of" />
        <Key word="text" />
        <Key word="image" />
        <Key word="style" />

        <Key word="structure"/>
        <Key word="item"/>
        <Key word="group"/>

        <Key word="copy-and-fill"/>
        <Key word="image-of"/>

        <Key word="chart" />
        <Key word="layer" />
        <Key word="dataset" />
        <Key word="data" />
        <Key word="barcode" />

        <Key word="validate" />
      </KeyWords>

      <KeyWords name = "Attributes" bold="false" italic="false" color="DarkRed" >
        <Key word="by"/>
        <Key word="datatype"/>
        
        <Key word="xmlns" />
        <Key word="type" />

        <Key word="ixs_frm" />
        <Key word="ixs_xme" />
        <Key word="xmeta_ver" />
        <Key word="xmeta_subver_min" />
        <Key word="nazev" />
        <Key word="ixs_alv" />
        <Key word="poznamka" />
        <Key word="rokmes_od" />
        <Key word="rokmes_do" />
        <Key word="last_modif" />
        <Key word="dat_modif" />

        <Key word="name" />
        <Key word="only-if"/>
        <Key word="filter-out"/>

        <Key word="paper-width" />
        <Key word="paper-height" />
        <Key word="left-margin" />
        <Key word="right-margin" />
        <Key word="top-margin" />
        <Key word="bottom-margin" />

        <Key word="onPrint" />
        <Key word="onEnter" />
        <Key word="onData" />
        <Key word="onLoad" />
        <Key word="width"/>
        <Key word="height"/>
        <Key word="rect"/>
        <Key word="row" />

        <Key word="value" />

        <Key word="file" />
        <Key word="global" />
        <Key word="image-width" />
        <Key word="image-height" />

        <Key word="id"/>
        <Key word="font-face" />
        <Key word="font-name" />
        <Key word="font-charset" />
        <Key word="font-size" />
        <Key word="font-bold" />
        <Key word="font-italic" />
        <Key word="font-underline" />
        <Key word="font-strikeout" />
        <Key word="font-color" />
        <Key word="border-width" />
        <Key word="left-border-width" />
        <Key word="right-border-width" />
        <Key word="top-border-width" />
        <Key word="bottom-border-width" />
        <Key word="border-color" />
        <Key word="left-border-color" />
        <Key word="right-border-color" />
        <Key word="top-border-color" />
        <Key word="bottom-border-color" />
        <Key word="border-style" />
        <Key word="left-border-style" />
        <Key word="right-border-style" />
        <Key word="top-border-style" />
        <Key word="bottom-border-style" />
        <Key word="horizontal-align" />
        <Key word="align" />
        <Key word="vertical-align" />
        <Key word="ellipsis-style" />
        <Key word="ellipsis-char" />
        <Key word="multiline" />
        <Key word="padding" />
        <Key word="left-padding" />
        <Key word="right-padding" />
        <Key word="top-padding" />
        <Key word="bottom-padding" />
        <Key word="background-color" />
        <Key word="text-orientation" />

        <Key word="image-stretch" />
        <Key word="image-orientation" />
        <Key word="component-stretch"/>  
        
        <Key word="version" />
        <Key word="encoding" />
        
        <Key word="maker" />
        <Key word="popis" />
        
        <Key word="ver_minor" />
        <Key word="ver_major" />

        <Key word="on-each-page"/>
        <Key word="break-page-before"/>
        <Key word="break-page-after"/>
        <Key word="endpage"/>

        <Key word="filename"/>
        <Key word="cell"/>
        <Key word="from"/>
        <Key word="to"/>
        <Key word="instance"/>

        <Key word="group-small"/>
        <Key word="group-limit"/>
        <Key word="shape"/>
        <Key word="color-palette"/>
        <Key word="legend"/>
        <Key word="label-layout"/>
        <Key word="label"/>
        <Key word="zero-affinity"/>
        <Key word="label-major-step"/>
        <Key word="label-minor-step"/>
        <Key word="draw3d"/>
        <Key word="series"/>
        <Key word="color"/>

        <Key word="xml:lang"/>
        <Key word="id"/>
        <Key word="note"/>
        <Key word="resource-id-value"/>
        <Key word="resource-id"/>

        <Key word="message"/>
        <Key word="order"/>
      </KeyWords>
    </RuleSet>

  </RuleSets>
</SyntaxDefinition>
