<?xml version="1.0" ?>

<!-- syntaxdefinition for SSR 2009 by Stepan Sukovych -->

<SyntaxDefinition name = "SSR" extensions = ".ssr" >

  <Digits   name = "Digits"   bold = "false" italic = "false" color = "DarkBlue"/>

  <RuleSets>

    <RuleSet ignorecase = "true">

      <Span name="Comment" bold="false" italic="true" color="DarkSlateGray" stopateol="false">
        <Begin>&lt;!--</Begin>
        <End>--&gt;</End>
      </Span>

      <Span name="SsrTagXml" rule="SsrTagSet" bold="false" italic="false" color="DarkMagenta" stopateol="false">
        <Begin>&lt;?</Begin>
        <End>?&gt;</End>
      </Span>

      <Span name="SsrTag" rule="SsrTagSet" bold="false" italic="false" color="DarkMagenta" stopateol="false">
        <Begin>&lt;</Begin>
        <End>&gt;</End>
      </Span>
    </RuleSet>

    <RuleSet name="SsrTagSet" ignorecase="false" >
      <Delimiters>/=</Delimiters>

      <Span name="String" bold="false" italic="false" color="Blue" stopateol="true" >
        <Begin color="Black">&quot;</Begin>
        <End color="Black">&quot;</End>
      </Span>

      <Span name="Char" bold="false" italic="false" color="Blue" stopateol="true">
        <Begin color="Black">&apos;</Begin>
        <End color="Black">&apos;</End>
      </Span>

      <MarkPrevious bold="false" italic="false" color="Black">=</MarkPrevious>

      <KeyWords name="Slash" bold="false" italic="false" color="DarkMagenta">
        <Key word="/"/>
      </KeyWords>

      <KeyWords name="Assignment" bold="true" italic="false" color="Black">
        <Key word="="/>
      </KeyWords>

      <KeyWords name = "Tags" bold="true" italic="false" color="DarkBlue">
        <Key word="xml" />
        <Key word="reports" />
        <Key word ="report" />
        <Key word="data" />
        <Key word="format" />
        <Key word="structure"/>
        <Key word="meta"/>
        <Key word="image-path"/>
        <Key word="image-global"/>
        <Key word="image-reloc"/>

      </KeyWords>

      <KeyWords name = "Attributes" bold="false" italic="false" color="Red" >
        <Key word="file"/>
        <Key word="title"/>
        <Key word="xmlns"/>
        <Key word="version"/>
        <Key word="encoding"/>
        <Key word="name"/>
        <Key word="path"/>
        <Key word="dat_modif"/>
        <Key word="ixs_alv"/>
        <Key word="crc"/>
        <Key word="id_ses"/>
        <Key word="default-format"/>

      </KeyWords>

    </RuleSet>

  </RuleSets>
</SyntaxDefinition>
