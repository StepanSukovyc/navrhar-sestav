<AddIn name        = "Start Page"
       author      = "Mgr. Stepan Sukovych"
       description = "Startovácí stránka Prohlížeče formulářů"
       addInManagerHidden = "preinstalled">

  <Manifest>
    <Identity name = "Gordic.Gfe.FormFiller.StartPage"/>
  </Manifest>

  <Runtime>
    <Import assembly=":Gordic.Gfe.FormFiller"/>
  </Runtime>

  <Path name = "/FormFiller/MainMenu/View">
    <MenuItem id = "ShowStartPage"
		          insertafter  = "HiddenObjectsSeparator"
		          insertbefore = "StartPageSeparator"
		          label = "Zobrazit startovací stránku"
		          icon  = "Icons.16x16.BrowserWindow"
		          class = "Gordic.Gfe.FormFiller.StartPage.ShowStartPageCommand"/>
    <MenuItem id = "StartPageSeparator"
				  insertbefore = "FullScreen"
				  type = "Separator"/>
  </Path>

  <Path name = "/Workspace/AutostartNothingLoaded">
    <Class id = "ShowStartPageCommand"
		       class = "Gordic.Gfe.FormFiller.StartPage.ShowStartPageCommand"/>
  </Path>
</AddIn>
