<AddIn name        = "SRZ vazba"
       author      = "Mgr. Stepan Sukovyč"
       description = "gres:29450802"
       addInManagerHidden = "preinstalled"
       version="4.82.0.2">

	<Manifest>
		<Identity name = "Gordic.GFE.WinClient.SrzBinding"/>
	</Manifest>

	<Runtime>
		<Import assembly=":Gordic.GFE.WinClient"/>
	</Runtime>

	<Path name = "/ReportDesigner/Desktop/LanguageBindings">
		<LanguageBinding id                   = "SRZ"
							 guid                 = "{75CFA488-D81D-4224-9EB5-3F1892F8EEC3}"
							 supportedextensions  = ".srz"
							 projectfileextension = ".srz"
							 class                = "Gordic.GFE.WinClient.SrzBinding.SrzSolutionBinding" />
	</Path>

	<!-- Prohlžeč projektu - nástroj vytvoření stromu -->
	<!--<Path name = "/ReportDesigner/Views/ProjectBrowser/NodeBuilders">
    <Class id = "SrzProjectBuilder"
		       class = "Gordic.GFE.WinClient.SrzBinding.SrzProjectNodeBuilder"/>
  </Path>-->

	<Path name = "/ReportDesigner/Desktop/Combine/FileFilter">
		<FileFilter id         = "SrzSolution"
						name       = "archiv"
						class      = "Gordic.GFE.WinClient.Project.LoadSolution"
						extensions = "*.srz"/>
	</Path>

	<Path name = "/Workspace/Icons">
		<Icon id         = "ArchiveFileIcon"
				  extensions = ".ssr"
				  resource   = "Icons__Gin__stav_archivovano" />
	</Path>

	<Path name = "/ReportDesigner/Desktop/SolutionTypeBindings">
		<SolutionTypeBindings id                   = "SRZ"
							 supportedextensions  = ".srz"
							 class                = "Gordic.GFE.WinClient.SrzBinding.SrzSolution" />
	</Path>

</AddIn>