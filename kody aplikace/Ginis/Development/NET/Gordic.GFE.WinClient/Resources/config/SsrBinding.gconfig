<AddIn name        = "SSR vazba"
       author      = "Mgr. Stepan Sukovyč"
       description = "gres:29450799"
       addInManagerHidden = "preinstalled"
       version="4.82.0.2">

	<Manifest>
		<Identity name = "Gordic.GFE.WinClient.SsrBinding"/>
	</Manifest>

	<Runtime>
		<Import assembly=":Gordic.GFE.WinClient"/>
	</Runtime>

	<Path name = "/ReportDesigner/Desktop/LanguageBindings">
		<LanguageBinding id                   = "SSR"
		                 guid                 = "{DF4D8BD0-63E5-43F3-9FA6-F83C3A794DBF}"
		                 supportedextensions  = ".ssr"
		                 projectfileextension = ".ssr"
		                 class                = "Gordic.GFE.WinClient.SsrBinding.SsrSolutionBinding" />
	</Path>

	<!-- Prohlžeč projektu - nástroj vytvoření stromu -->
	<Path name = "/ReportDesigner/Views/ProjectBrowser/NodeBuilders">
		<Class id = "SsrProjectBuilder"
				   class = "Gordic.GFE.WinClient.SsrBinding.SsrProjectNodeBuilder"/>
	</Path>

	<Path name = "/ReportDesigner/Desktop/Combine/FileFilter">
		<FileFilter id         = "SsrSolution"
						name       = "prohlížeč"
						class      = "Gordic.GFE.WinClient.Project.LoadSolution"
						extensions = "*.ssr"/>
	</Path>

	<!-- vlastnosti -->
	<Path name = "/ProjectPropertyDialog" icon="Icons__Gin__vlastnosti">
		<DialogPanel id = "SsrFileNode"
				 label = "gres:29450253"
				 class = "Gordic.GFE.WinClient.SsrBinding.SsrFileNodePanel"/>
		<DialogPanel id = "SsrProjectSettings"
				 label = "gres:29450800"
				 class = "Gordic.GFE.WinClient.SsrBinding.SsrProjectSettingsPanel"/>
	</Path>

	<Path name = "/Desktop/ArchiveFilter">
		<FileFilter id = "SRZarchive"
						name = "gres:29450801"
						extensions = "*.srz"/>
	</Path>

	<Path name = "/Workspace/Icons">
		<Icon id         = "ArchiveFileIcon"
				  extensions = ".srz"
				  resource   = "Icons__Gin__stav_archivovano" />

		<Icon id         = "ALVFileIcon"
				  extensions = ".alv"
				  resource   = "Icons__Ssl__sip_balicek_generovat" />
	</Path>

	<Path name = "/ReportDesigner/Desktop/SolutionTypeBindings">
		<SolutionTypeBindings id                   = "SSR"
							 supportedextensions  = ".ssr"
							 class                = "Gordic.GFE.WinClient.SsrBinding.SsrSolution" />
	</Path>

</AddIn>