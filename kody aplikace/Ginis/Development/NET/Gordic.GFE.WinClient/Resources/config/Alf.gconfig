						  icon ="Icons__Gin__zaznam_novy_vlozit_pred"
						  loadclasslazy = "false"
						  class = "Gordic.GFE.WinClient.SpecificFormatCommands.ApplyFormat"/>
				<MenuItem id = "PropertySeparator" type = "Separator"  />
				<MenuItem id = "ShowProperty"
						  label = "gres:29450734"
						  type = "Item"
						  shortcut = "Control|D"
						  icon ="Icons__Gin__vlastnosti"
