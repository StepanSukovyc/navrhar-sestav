			<ListItem value="label"/>
			<ListItem value="legend"/>
			<ListItem value="draw3d"/>
			<ListItem value="color"/>
			<ListItem value="name" />
		</List>
		<List id="AddButtonArea">
			<ListItem value="guid" />
		</List>
		<List id="LayerDataSetTags">
			<ListItem value="name" />
			<ListItem value="series"/>
			<ListItem value="color"/>
		</List>
	</Path>
	<Path name="/Formation/Components">
		<List id="AddButtonArea">
			<ListItem value="guid" />
		</List>
	</Path>
