<AddIn name        = "Data Editor"
       author      = "Mgr. Stepan Sukovyč"
       description = "gres:29450975"
       addInManagerHidden = "preinstalled"
       version="5.25.0.1">

	<Manifest>
		<Identity name = "Gordic.GFE.WinClient.DataEditor"/>
	</Manifest>

	<Runtime>
		<Import assembly=":Gordic.GFE.WinClient"/>
	</Runtime>

	<!-- Data Editor View -->
	<Path name = "/Desktop/DisplayBindings">
		<DisplayBinding id = "DataEditor"
					insertbefore = "Text"
					title = "gres:29450976"
					class = "Gordic.GFE.WinClient.DataEditor.DataDisplayBinding"/>
	</Path>
	<!-- konec Data Editor View -->

	<!-- Data analyzátory -->
	<Path name = "/Workspace/Parser">
		<Parser id = "DataFoldingParser"
					supportedextensions  = ".dat;.xml;.tmp;"
					class = "Gordic.GFE.WinClient.DataEditor.Parser"/>
	</Path>
	<!-- konec Data analyzátory -->

	<!-- SEZNAMY -->
	<Path name="/GlobalList">
		<List id="Relation">
			<ListItem key=".tmp" value="Data"/>
			<ListItem key=".dat" value="Data"/>
			<ListItem key=".txt" value="Data"/>
		</List>
	</Path>

	<!-- Data souborový filter -->
	<Path name = "/Desktop/FileFilter">
		<FileFilter id = "XML"
						name = "gres:29450771"
						insertbefore="AllFiles"
						extensions = "*.xml"/>
		<FileFilter id = "data"
						insertbefore="XML"
						name = "gres:29450772"
						extensions = "*.dat;*.tmp"/>
	</Path>
	<!-- konec Data souborový filter -->

</AddIn>