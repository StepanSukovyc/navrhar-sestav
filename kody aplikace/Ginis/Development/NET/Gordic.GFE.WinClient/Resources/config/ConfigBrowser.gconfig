<AddIn name        = "ConfigBrowser"
       author      = "Mgr. Stepan Sukovyč"
       description = "gres:29450974"
       addInManagerHidden = "preinstalled"
       version="4.82.0.2">

	<Manifest>
		<Identity name = "Gordic.GFE.WinClient.ConfigBrowser"/>
	</Manifest>

	<Runtime>
		<Import assembly=":Gordic.GFE.WinClient"/>
	</Runtime>

	<Path name = "/Workspace/Tools">
		<MenuItem id = "ShowConfigBrowser"
		          label = "gres:29450247"
				  icon  = "Icons__Gin__hledat_dle_vlastnosti"
		          class = "Gordic.GFE.WinClient.ConfigBrowser.ConfigBrowserCommand"/>
		<MenuItem id = "Separator1" type = "Separator" />
	</Path>
</AddIn>
