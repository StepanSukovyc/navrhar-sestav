	<!-- Kontextové menu záložek -->
	<Path name = "/ReportDesigner/Desktop/OpenFileTab/ContextMenu">
		<Condition name = "WindowActive" activewindow="*" action="Disable">
			<MenuItem id = "CloseFile"
					  label = "gres:29450895"
					  icon  = "Icons__Gin__okno_zavrit"
					  shortcut = "Control|F4"
					  class ="Gordic.GFE.WinClient.FileCommands.CloseFile"/>
		</Condition>
		<MenuItem id    = "CloseAll"
					  icon  = "Icons.16x16.CloseAllDocuments"
					  label = "gres:29450896"
					  class = "Gordic.GFE.WinClient.FileCommands.CloseAllWindows" />
		<MenuItem id    = "CloseAllButThis"
					  label = "gres:29450897"
					  class = "Gordic.GFE.WinClient.FileTabStripCommands.CloseAllButThisFileTab" />

		<MenuItem id = "CloseSeparator" type = "Separator" />
		<Condition name = "ActiveWindowState" windowstate="Dirty, Untitled" nowindowstate="ViewOnly" action="Disable">
			<MenuItem id = "Save"
							label = "gres:29450898"
							  icon = "Icons__Gin__ulozit"
							  shortcut = "Control|S"
							  class = "Gordic.GFE.WinClient.FileCommands.SaveFile"/>
		</Condition>
		<MenuItem id = "SaveAs"
						  icon = "Icons__Gin__ulozit_jako"
						  label = "gres:29450831"
						  shortcut = "Control|Shift|S"
						  loadclasslazy = "false"
				  class = "Gordic.GFE.WinClient.FileCommands.SaveFileAs"/>
		<MenuItem id = "SaveDb"
				icon = "Icons__Gin__ulozit_do_databaze"
				label = "gres:29450899"
				loadclasslazy = "false"
				class = "Gordic.GFE.WinClient.FileCommands.SaveFileToDatabase"/>
		<Condition name = "OpenWindowState" openwindowstate="Dirty" action="Disable">
			<MenuItem id = "SaveAll"
							icon = "Icons.16x16.SaveAllIcon"
							label = "gres:29450900"
							class = "Gordic.GFE.WinClient.FileCommands.SaveAllFiles"/>
		</Condition>
		<ComplexCondition action="Exclude">
			<And>
				<Not>
					<Condition name="WindowActive" activewindow="StartPane"/>
				</Not>
				<Not>
					<Condition name = "Ownerstate" ownerstate="FileUntitled" />
				</Not>
			</And>
			<MenuItem id = "SaveSeparator" type = "Separator" />
			<MenuItem id = "CopyPathName"
							label = "gres:29450901"
					  class = "Gordic.GFE.WinClient.FileTabStripCommands.CopyPathName"/>
			<MenuItem id = "OpenFolderContainingFileFromTab"
							label = "gres:29450876"
					  icon ="Icons__Gin__prehled_ulozene"
							class = "Gordic.GFE.WinClient.FileTabStripCommands.OpenFolderContainingFile"/>
		</ComplexCondition>
	</Path>
