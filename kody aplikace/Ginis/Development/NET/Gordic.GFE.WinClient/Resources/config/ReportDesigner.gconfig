						 class = "Gordic.GFE.WinClient.EditCommands.Delete"/>
	</Path>
	<!-- konec EDIT -->

	<!-- Sekce NÁSTROJE -->
	<Path name="/ReportDesigner/ToolBar/ToolsSection">
		<!-- nabídka se objeví pouze pro sestavy implementující rozhraní IGenerateFormationHandler -->
		<ComplexCondition action="Exclude">
			<And>
				<Condition name = "WindowActive" activewindow="IGenerateFormationHandler" />
			</And>
			<ToolbarItem id = "FormCreate"
					icon = "Icons__Gin__formular"
					tooltip = "gres:29450849"
					type="Item"
					class = "Gordic.GFE.WinClient.ToolsCommands.GenerateFormation"/>
		</ComplexCondition>
		<ToolbarItem id = "FormSeparator" type = "Separator"  />
		<ToolbarItem id="GlobalScripts"
				  tooltip="gres:29450868"
				  type="Item"
				  icon="Icons__Gin__ciselnik_editace"
				  loadclasslazy="false"
				  class="Gordic.GFE.WinClient.ToolsCommands.GlobalScripts"/>
		<ToolbarItem id="Languages"
				  tooltip="gres:29450869"
				  label="CS"
				  type="Item"
				  loadclasslazy="false"
				  class="Gordic.GFE.WinClient.ToolsCommands.Languages"/>
		<ToolbarItem id = "SpecificFormatSeparator" type = "Separator"  />
		<ToolbarItem id="HiddenObjects"
			  tooltip="gres:29450870"
			  type="CheckBox"
			  icon="Icons__Wfl__dokument_odeslat_original"
			  loadclasslazy="false"
			  class="Gordic.GFE.WinClient.SpecificFormatCommands.CheckHiddenObjects"/>
	</Path>
	<!-- konec SESTAV -->
	<!-- Stránka -->
	<Path name="/ReportDesigner/ToolBar/Page">
		<Condition name = "WindowActive" activewindow="Gordic.GFE.WinClient.Gui.IPageHandler" action="Disable">
			<ToolbarItem id="Format"
					type="ComboBox"
					tooltip="gres:29450871"
					class="Gordic.GFE.WinClient.PageCommands.Format">
				<IncludeDictionary id = "Formats" item="/GlobalList/PageFormats"/>
			</ToolbarItem>
			<ToolbarItem id="Settings"
				  type="Item"
				  tooltip="gres:29450872"
				  icon="Icons__Gin__vlastnosti"
				  class="Gordic.GFE.WinClient.PageCommands.Settings"/>
		</Condition>
	</Path>
	<!-- konec Stránka -->
	<!-- PÍSMO -->
	<Path name="/ReportDesigner/ToolBar/Font">
		<ToolbarItem id="ForeColor"
					 tooltip="gres:29450873"
					 type="ComboBox"
					 loadclasslazy="false"
					 class="Gordic.GFE.WinClient.FontCommands.FontForeColor">
			<IncludeDictionary id = "ListOfColors" item="/GlobalList/ColorNameCZEN"/>
		</ToolbarItem>
		<ToolbarItem id="FontName"
					 tooltip="gres:29450753"
					 type="ComboBox"
