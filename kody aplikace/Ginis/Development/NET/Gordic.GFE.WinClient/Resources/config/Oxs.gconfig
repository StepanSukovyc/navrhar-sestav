<AddIn name        = "Oxs Editor"
       author      = "Mgr. Stepan Sukovyč"
       description = "gres:29450960"
       addInManagerHidden = "preinstalled"
       version="4.82.0.2">
	
	<Manifest>
		<Identity name = "Gordic.GFE.WinClient.OxsEditor"/>
	</Manifest>

  <Runtime>
    <Import assembly=":Gordic.GFE.WinClient"/>
  </Runtime>
	
  <!-- Dialogy nastavení Designéru -->
  <Path name = "/ReportDesigner/Dialogs/OptionsDialog/DesignerOptions" >
    <DialogPanel id = "OXS"
		             label = "gres:29450961"
                 insertafter="MSE"
		             class = "Gordic.GFE.WinClient.Editor.DesignerMSEPanel"/>
  </Path>
  <!-- Konec nastavení designéru -->

  <!-- OXS menu -->
	<Path name = "/ReportDesigner/MainMenu">
		<Condition name = "WindowActive" activewindow="Gordic.GFE.WinClient.Editor.OxsViewContent">
			<MenuItem id = "MmOxs" insertafter="View" insertbefore="Tools" label="gres:29450962" type = "Menu">
        <MenuItem id = "MmOxsValidation"
                  icon = "Icons__Gin__kontrola"
                  loadclasslazy = "false"
                  label = "gres:29450805"
                  class = "Gordic.GFE.WinClient.Editor.ExcelValidateCommand"/>
        <MenuItem id = "MmOxsForceGenerate"
                  icon = "Icons__Gin__sestava_generovat"
                  loadclasslazy = "false"
                  label = "gres:29450806"
                  class = "Gordic.GFE.WinClient.Editor.OfficeForceGenerateCommand"/>
        <MenuItem id="MmOxsObjectProperty"
                  icon="Icons__Gin__vlastnosti"
                  loadclasslazy="false"
                  label = "gres:29450807"
                  class="Gordic.GFE.WinClient.Gui.ShowProperty"/>
      </MenuItem>
    </Condition>
	</Path>
  <!-- konec OXS menu -->
  
  <!-- ToolBar nabídka OXS sestavy -->
  <Path name = "/ReportDesigner/ToolBarMenu/Standard">
    <Condition name = "WindowActive" activewindow="Gordic.GFE.WinClient.Editor.OxsViewContent">
      <ToolbarItem id = "OXSSeparator" type = "Separator" insertafter="Redo" />
      <ToolbarItem id="TbOxsValidation"
                   tooltip="gres:29450805"
                   icon = "Icons__Gin__kontrola"
                   loadclasslazy = "false"
                   class = "Gordic.GFE.WinClient.Editor.ExcelValidateCommand"
                   insertafter="MSESeparator"/>
      <ToolbarItem id="TbOxsForceGenerate"
                         tooltip="gres:29450808"
                         icon = "Icons__Gin__sestava_generovat"
                         loadclasslazy = "false"
                         class = "Gordic.GFE.WinClient.Editor.OfficeForceGenerateCommand"
                         insertafter="TbMseValidation"/>
      <ToolbarItem id="TbOxsObjectProperty"
                   tooltip="gres:29450734"
                   icon = "Icons__Gin__vlastnosti"
                   loadclasslazy = "false"
                   class = "Gordic.GFE.WinClient.Gui.ShowProperty"
                   insertafter="TbOxsValidation"/>
    </Condition>
  </Path>
  <!-- konec ToolBar nabídka OXS sestavy-->
  
</AddIn>