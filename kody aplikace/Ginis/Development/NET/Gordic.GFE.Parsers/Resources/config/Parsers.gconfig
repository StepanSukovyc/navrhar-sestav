<AddIn name        = "Parsers"
       author      = "Mgr. Stepan Sukovyč"
       description = "gres:29450769"
       addInManagerHidden="true"
       version="4.82.0.0">

  <Manifest>
    <Identity name = "Gordic.GFE.Parsers"/>
  </Manifest>
  
  <!-- Prostředí aplikace -->
  <Runtime>
      <Import assembly=":Gordic.GFE.Parsers"/>  
  </Runtime>
  <!-- konec prostředí -->
  
  <!-- DOM contextové menu -->
  <Path name = "/Dom/PagePanel/ContextMenu">
    <MenuItem id = "Save"
          label = "gres:21000033"
          type = "Item"
          icon ="Icons__Gin__ulozit"
          loadclasslazy = "false"
          class = "Gordic.GFE.Parsers.SaveFile"/>
    <MenuItem id = "Save"
          label = "gres:29450770"
          type = "Item"
          icon ="Icons__Gin__ulozit_jako"
          loadclasslazy = "false"
          class = "Gordic.GFE.Parsers.SaveFileAs"/>
    <MenuItem id = "SaveSeparator" type = "Separator"  />
    <MenuItem id = "ShowGrid"
              label = "gres:29450771"
              type = "CheckBox"
              shortcut = "Control|G"
              icon ="Icons__Gin__format_sloupce"
              loadclasslazy = "false"
              class = "Gordic.GFE.Parsers.Core.ShowGrid"/>
    <MenuItem id = "ShowColorOf"
              label = "gres:29450772"
              type = "CheckBox"
                shortcut = "Control|Q"
              icon ="Icons__Gin__oblast"
              loadclasslazy = "false"
              class = "Gordic.GFE.Parsers.Core.ShowColorOf"/>
  </Path>
  <!-- konec GRF menu -->

  <!-- SEZNAMY -->
  <Path name="/GlobalList">
    <List id="Zoom">
      <ListItem value="20 %" />
      <ListItem value="50 %"/>
      <ListItem value="70 %"/>
      <ListItem value="100 %"/>
      <ListItem value="150 %"/>
      <ListItem value="200 %" />
      <ListItem value="400 %" />
      <ListItem value="gres:29450773" />
    </List>
    <List id="SurroundWidth">
      <ListItem value="0" />
      <ListItem value="1" />
      <ListItem value="2"/>
      <ListItem value="3"/>
      <ListItem value="4"/>
      <ListItem value="5"/>
      <ListItem value="6" />
      <ListItem value="7" />
      <ListItem value="8" />
    </List>
    <List id="DashStyle">
      <ListItem value="gres:29450747"/>
      <ListItem value="gres:29450748"/>
      <ListItem value="gres:29450749"/>
      <ListItem value="gres:29450750"/>
      <ListItem value="gres:29450751"/>
    </List>
    <List id="ColorNameCZEN">
      <ListItem key="aqua" value="gres:29450774"/>
      <!-- //const int htmlAqua    = 0x00FFFF00; // aqua -->
      <ListItem key="black" value="gres:29450775"/>
      <!-- {Color.Black, ""},     //const int htmlBlack   = 0x00000000; // black -->
      <ListItem key="blue" value="gres:29450776"/>
      <!-- //const int htmlBlue    = 0x00FF0000; // blue -->
      <ListItem key="fuchsia" value="gres:29450777"/>
      <!-- //const int htmlFuchsia = 0x00FF00FF; // fuchsia -->
      <ListItem key="gray" value="gres:29450778"/>
      <!-- //const int htmlGray	  = 0x00808080; // gray -->
      <ListItem key="green" value="gres:29450779"/>
      <!-- //const int htmlGreen	  = 0x00008000; // green -->
      <ListItem key="#90ee90" value="gres:29450780"/>
      <!-- // #90ee90 
      <ListItem key="lime" />-->
      <!-- //const int htmlLime	  = 0x0000FF00; // lime -->
      <ListItem key="maroon" value="gres:29450781"/>
      <!-- //const int htmlMaroon  = 0x00000080; // maroon -->
      <ListItem key="navy" value="gres:29450782"/>
      <!-- //const int htmlNavy	  = 0x00800000; // navy -->
      <ListItem key="olive" value="gres:29450783"/>
      <!-- //const int htmlOlive	  = 0x00008080; // olive -->
      <ListItem key="purple" value="gres:29450784"/>
      <!-- //const int htmlPurple  = 0x00800080; // purple -->
      <ListItem key="red" value="gres:29450785"/>
      <!-- //const int htmlRed     = 0x000000FF; // red -->
      <ListItem key="silver" value="gres:29450786"/>
      <!-- //const int htmlSilver  = 0x00C0C0C0; // silver     //gray 25% -->
      <ListItem key="teal" value="gres:29450787"/>
      <!-- //const int htmlTeal	  = 0x00808000; // teal -->
      <ListItem key="white" value="gres:29450788"/>
      <!-- //const int htmlWhite	  = 0x00FFFFFF; // white -->
      <ListItem key="yellow" value="gres:29450789"/>
      <!-- //const int htmlYellow  = 0x0000FFFF; // yellow -->
      <ListItem key="transparent" value="gres:29450372"/>
    </List>
  </Path>
  <!-- konec SEZNAMY -->

  <!-- Filtry souborů -->
  <Path name = "/Desktop/FileFilter">
    <FileFilter id = "ALF"
		            insertbefore="AllFiles"
		            name = "gres:29450790"
		            extensions = "*.alf"/>
    <FileFilter id         = "SaveAlfxFile"
		            insertbefore="ALF"
		            name       = "gres:29450790"
		            extensions = "*.alfx"/>
    <FileFilter id         = "SaveGfrmFile"
		            insertbefore="SaveAlfxFile"
		            name       = "gres:29450791"
		            extensions = "*.gfrm"/>
  </Path>
  <Path name = "/Desktop/HelpFileFilter">
    <FileFilter id = "CHM"
		            name = "gres:29450792"
		            extensions = ".chm"/>
  </Path>
  <!-- konec Filtry souborů -->
  <Path name = "/Dom/PropertyDialog" icon="Icons__Gin__vlastnosti"/>
</AddIn>