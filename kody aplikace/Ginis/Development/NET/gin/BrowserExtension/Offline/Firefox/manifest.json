{
  "manifest_version": 3,
  "short_name": "GBE",
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "version": "2.5.0.0",
  "icons": {
    "16": "Gv2_16.png",
    "24": "Gv2_24.png",
    "32": "Gv2_32.png"
  },
  "default_locale": "cs",
  "action": {
    "default_icon": "Gv2_24.png",
    "default_title": "__MSG_defTitle__",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cz.gordic.chrome.gbe@gordic.cz",
      "strict_min_version": "105.0",
      "update_url": "https://www.gordic.cz/browser_extensions/updates.json"
    }
  },
  "homepage_url": "http://www.gordic.cz/",
  "permissions": [
    "notifications",
    "tabs",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content.js" ],
      "all_frames": true
    }
  ],
  "background": {
    "scripts": [ "background.js" ]
  },
  "web_accessible_resources": [
    {
      "resources": [ "logo_gordic.png" ],
      "matches": [ "<all_urls>" ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' ; object-src 'self'"
  }

}