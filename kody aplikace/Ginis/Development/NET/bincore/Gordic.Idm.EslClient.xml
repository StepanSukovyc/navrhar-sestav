        <member name="M:Gordic.Idm.EslClient.EslAttributesExtensions.DateTimeRe">
            <remarks>
            Pattern:<br/>
            <code>(?&lt;day&gt;\\d{2})\\.(?&lt;month&gt;\\d{2})\\.(?&lt;year&gt;\\d{4})\\s(?&lt;hour&gt;\\d{1,2})\\:(?&lt;minute&gt;\\d{1,2})\\:(?&lt;second&gt;\\d{1,2})</code><br/>
            Options:<br/>
            <code>RegexOptions.Compiled</code><br/>
            Explanation:<br/>
            <code>
            ○ "day" capture group.<br/>
                ○ Match a Unicode digit exactly 2 times.<br/>
            ○ Match '.'.<br/>
            ○ "month" capture group.<br/>
                ○ Match a Unicode digit exactly 2 times.<br/>
            ○ Match '.'.<br/>
            ○ "year" capture group.<br/>
                ○ Match a Unicode digit exactly 4 times.<br/>
            ○ Match a whitespace character.<br/>
            ○ "hour" capture group.<br/>
                ○ Match a Unicode digit atomically at least 1 and at most 2 times.<br/>
            ○ Match ':'.<br/>
            ○ "minute" capture group.<br/>
                ○ Match a Unicode digit atomically at least 1 and at most 2 times.<br/>
            ○ Match ':'.<br/>
            ○ "second" capture group.<br/>
                ○ Match a Unicode digit atomically at least 1 and at most 2 times.<br/>
            </code>
            </remarks>
        </member>
