<?xml version="1.0" encoding="utf-8" ?>

<!-- Rychlý návod na NLog.config: https://github.com/NLog/NLog/wiki/Tutorial#configure-nlog-targets-for-output -->
<!-- Seznam logovacích úrovní NLog: https://github.com/NLog/NLog/wiki/Configuration-file#log-levels -->
<!-- Pokročilejší konfigurace NLog.config: https://github.com/NLog/NLog/wiki/Configuration-file -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" throwExceptions="false">

	<targets async="true">
		<target xsi:type="File" name="file1" fileName="c:\temp\Logs\${faze}.log"
		  layout="${longdate}|${activity:property=Id}|${level:uppercase=true}|${logger}|${threadid}|${user}|${message}|${all-event-properties}|${exception}"
		  archiveAboveSize="100000000" maxArchiveFiles="1" concurrentWrites="true"/>
	</targets>

	<rules>
    <logger name="Microsoft.*" maxLevel="Debug" final="true" />                      <!-- TRACE a DEBUG nelogujeme -->
    <logger name="System.Net.Http.*" maxLevel="Debug" final="true" />                <!-- TRACE a DEBUG nelogujeme -->

    <logger name="*" minlevel="Debug" writeTo="file1"/>
	</rules>

</nlog>