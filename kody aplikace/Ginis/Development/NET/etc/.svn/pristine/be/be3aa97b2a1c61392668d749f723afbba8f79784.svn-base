{
  "compileOnSave": true,
  "compilerOptions": {
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "declaration": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "removeComments": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "target": "es2020"
  }
}
