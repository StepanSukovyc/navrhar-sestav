<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--install-remove:microsoft.web.services3-->
    <configSections>
        <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General"/>
    </configSections>
    <Gordic>
        <Ginis>
            <GSSAUT01>
                <!-- příznak offline podpory období klidu databáze -->
                <Use-offline-idle>true</Use-offline-idle>
                
                <!-- příznak automatického uzavírání prošlých databázových relací -->
                <Close-obsolete-sessions>true</Close-obsolete-sessions>
                
                <!-- maximální doba čekání na zpracování klientského požadavku autorizační službu v sekundách -->
                <Service-call-timeout>90</Service-call-timeout>
                
                <!-- prodleva před dalším pokusem o přihlášení k nedostupné nebo uzamčené databázi v sekundách -->
                <Inaccessible-database-delay>30</Inaccessible-database-delay>
                
                <!-- časový limit pro kontrolu deadlocku autorizační služby v sekundách -->
                <Deadlock-timeout>600</Deadlock-timeout>
                
                <!-- příznak restartu služby v důsledku neotevřené databázové transakce -->
                <Treat-not-transaction>false</Treat-not-transaction>

                <!-- příznak provádění kontroly doménového identifikátoru uživatele -->
                <Check-domain-sid>false</Check-domain-sid>

                <!-- příznak odmítnutí přístupu k zakázaným databázovým parametrům -->
                <Deny-banned-parameters>true</Deny-banned-parameters>
                
                <!-- povolený počet neúspěšných pokusů o přihlášení v řadě, po jehož překročení dojde k dočasném uzamčení uživatelského účtu -->
                <Wrong-login-attempts>2</Wrong-login-attempts>

                <!-- doba trvání dočasného uzamčení účtu po překročení povoleného počtu neúspěšných pokusů o přihlášení v minutách -->
                <Wrong-login-lock-time>2</Wrong-login-lock-time>

                <!-- cesta k souboru s nastavením autorizační služby -->
                <!--<Service-settings-path>c:\tmp\aaa.xml</Service-settings-path>-->

                <!-- časový limit pro trvání interní synchronizace autorizační služby v sekundách -->
                <Adjust-duration-limit>60</Adjust-duration-limit>

                <!-- časový limit pro trvání automaticky přihlašované relace autorizační služby v minutách -->
                <Session-duration-limit>60</Session-duration-limit>

                <!-- frekvence občerstvování relace autorizační služby v minutách -->
                <Session-refresh-frequency>10</Session-refresh-frequency>

            </GSSAUT01>
            <All>
                <!-- výchozí databázový profil -->
                <!-- <Default-profile></Default-profile> -->

                <!-- URL autorizační služby -->
                <!-- <Auth-service-url></Auth-service-url> -->

                <!-- URL alternativní autorizační služby -->
                <!-- <Auth-service-url2></Auth-service-url2> -->

                <!-- časový limit pro dokončení požadavku na autorizační službu v sekundách -->
                <!-- <Auth-service-timeout>30</Auth-service-timeout> -->

                <!-- příznak ověřování důvěry mezi aplikacemi autorizační službou -->
                <!--<Auth-service-trust>true</Auth-service-trust>-->

                <!-- typ autorizace do GINISu (jedna z hodnot ginis, windows, anonymous, public) -->
                <Auth-type>anonymous</Auth-type> 

                <!-- kultura pro lokalizaci aplikace -->
                <!-- <Culture>cs-CZ</Culture> -->

                <!-- seznam povolených databázových profilů -->
                <!-- <Allowed-profiles></Allowed-profiles> -->

                <!-- příznak povinného zobrazení přihlašovacího dialogu -->
                <!-- <Force-login>true</Force-login> -->

                <!-- režim přihlášení (1=řádné přihlášení, 2=zástup, 3=kombinace řádného přihlášení a zástupu, 4=automatické přihlášení) -->
                <!-- <Default-rezim>1</Default-rezim> -->

                <!-- nastavení aplikačního logu do txt souboru -->
                <!-- <Log><Output-txt outputFile="c:\temp\GSAxxx01.log.txt" maxSize="100"/></Log> -->

                <!-- nastavení aplikačního logu do txt souboru s veškerými podrobnostmi -->
                <!-- <Log><Output-txt outputFile="c:\temp\GSAxxx01.log.txt" logLevel = "+Verbose" maxSize="100"/></Log> -->

                <!-- způsob odesílání e-mailových zpráv (smtp nebo emapi) -->
                <!-- <Mail-method>smtp</Mail-method> -->

                <!-- adresa serveru pro odesílání e-mailových zpráv -->
                <!-- <Mail-server></Mail-server> -->

                <!-- port serveru pro odesílání e-mailových zpráv -->
                <!-- <Mail-port>25</Mail-port> -->

                <!-- přihlašovací jméno pro odesílání e-mailových zpráv -->
                <!-- <Mail-user></Mail-user> -->

                <!-- heslo pro odesílání e-mailových zpráv -->
                <!-- <Mail-password></Mail-password> -->

                <!-- adresa odesílatele e-mailových zpráv -->
                <!-- <Mail-from></Mail-from> -->

                <!-- seznam adres příjemců e-mailových zpráv (adresy v seznamu musí být odděleny středníkem) -->
                <!-- <Mail-to></Mail-to> -->

                <!-- seznam adres příjemců kopie e-mailových zpráv (adresy v seznamu musí být odděleny středníkem) -->
                <!-- <Mail-cc></Mail-cc> -->

                <!-- seznam adres příjemců skryté kopie e-mailových zpráv (adresy v seznamu musí být odděleny středníkem) -->
                <!-- <Mail-bcc></Mail-bcc> -->

                <!-- adresa pro odpověď na e-mailové zprávy -->
                <!-- <Mail-reply-to></Mail-reply-to> -->

                <!-- název profilu odesílatele e-mailových zpráv (hodnota default značí výchozí profil aktuálního uživatele) -->
                <!-- <Mail-profile></Mail-profile> -->

                <!-- název počítače odesílatele e-mailových zpráv -->
                <!-- <Mail-client></Mail-client> -->

                <!-- příznak použití předpony pro SMTP (true nebo false) -->
                <!-- <Mail-use-prefix>false</Mail-use-prefix> -->

                <!-- příznak použití dialogu pro extended MAPI (true nebo false) -->
                <!-- <Mail-use-dialog>false</Mail-use-dialog> -->

                <!-- maximální přípustná velikost zprávy v Bytech (hodnota menší než 1 značí neomezenou velikost)  -->
                <!-- <Mail-max-size>10</Mail-max-size> -->

                <!-- kódová stránka pro e-mailové zprávy -->
                <!-- <Mail-encoding>iso-8859-2</Mail-encoding> -->

                <!-- příznak generování požadavku na potvrzení přečtení mailu -->
                <!-- <Mail-confirm>false</Mail-confirm> -->

                <!-- příznak požadavku na podepsání e-mailové zprávy -->
                <!-- <Mail-sign>false</Mail-sign> -->

                <!-- sériové číslo certifikátu pro podepsání e-mailové zprávy -->
                <!-- <Mail-certificate-serial-no></Mail-certificate-serial-no> -->

                <!-- otisk certifikátu pro podepsání e-mailové zprávy -->
                <!-- <Mail-certificate-thumbprint></Mail-certificate-thumbprint> -->

                <!-- algoritmus kontrolního součtu pro podepsání e-mailové zprávy (přípustné hodnoty jsou Sha1, Sha256, Sha384, Sha512, Md5, Md2 nebo Ripemd160) -->
                <!-- <Mail-hash-algorithm>Sha256</Mail-hash-algorithm> -->

                <!-- umístění uložiště certifikátů pro podepsání e-mailové zprávy (přípustné hodnoty jsou CurrentService, CurrentUser, CurrentUserGroupPolicy, LocalMachine, LocalMachineEnterprise, LocalMachineGroupPolicy, Services nebo Users) -->
                <!-- <Mail-store-location></Mail-store-location> -->

                <!-- název uložiště certifikátů pro podepsání e-mailové zprávy (přípustné hodnoty jsou Addressbook, AuthRoot, Ca, Disallowed, My, Root, Spc, Trust, TrustedPeople, TrustedPublisher nebo Twins) -->
                <!-- <Mail-store-name></Mail-store-name> -->

                <!-- příznak požadavku na použití standardní .NET implementace podepisování e-mailové zprávy namísto knihoven SecureBlackbox -->
                <!-- <Mail-net-cryptography>false</Mail-net-cryptography> -->

                <!-- příznak použití protokolu SSL pro odesílání e-mailových zpráv přes SMTP (true nebo false) -->
                <!-- <Mail-use-ssl>false</Mail-use-ssl> -->

                <!-- adresář pro dočasné soubory generátoru sestav -->
                <!-- <Reporter-temp-path>c:\temp</Reporter-temp-path> -->

                <!-- cesta pro umístění žurnálu generátoru sestav -->
                <!-- <Reporter-journal>c:\temp\reporter.log.txt</Reporter-journal> -->

                <!-- příznak kontroly společných Win32 knihoven při startu aplikace -->
                <Gin-presence-required>false</Gin-presence-required> 

                <!-- příznak přítomnosti výpisu zásobníku v textu výjimek -->
                <Exception-stack-trace>true</Exception-stack-trace> 

                <!-- přednastavená url adresa pro odesílání chybových hlášení -->
                <!-- <Send-errors-to></Send-errors-to> -->

                <!-- příznak logování výjimek do databáze -->
                <!-- <Log-errors>false</Log-errors> -->

                <!-- příznak zápisu výjimek do systémového aplikačního logu -->
                <!-- <Use-event-log>true</Use-event-log> -->

                <!-- příznak požadavku na provádění testu OLE DB provideru -->
                <!-- <Check-provider>false</Check-provider> -->

                <!-- příznak požadavku na provádění testu verze OLE DB provideru -->
                <!-- <Check-provider-version>true</Check-provider-version> -->

                <!-- cesta k adresáři pro dočasné soubory -->
                <!-- <Temp-path>c:\temp</Temp-path> -->

                <!-- příznak provádění offline kontroly období klidu databáze -->
                <!-- <Use-offline-idle>true</Use-offline-idle> -->

                <!-- příznak povolení neověřeného SSL certifikátu -->
                <!-- <Allow-unstrusted-ssl-certificate>true</Allow-unstrusted-ssl-certificate> -->

                <!--maximální velikost zprávy v bytech (0=výchozí hodnota, -1=bez omezení)-->
                <!-- <Max-message-size>0</Max-message-size> -->

                <!-- příznak řízení auditních informací databázové relace -->
                <!-- <Database-session-audit>true</Database-session-audit> -->

                <!-- příznak načítání databázových parametrů prostřednictvím pracovní tabulky -->
                <!-- <Use-dbparams-table>true</Use-dbparams-table> -->

                <!-- nastavení databázových profilů -->
                <!-- <Profiles> -->
                    <!-- <Profile name=""> -->
                        <!-- typ databázového stroje (jedna z hodnot informix, oracle, mssql) -->
                        <!-- <Database-type></Database-type> -->

                        <!-- název databáze -->
                        <!-- <Database></Database> -->

                        <!-- název datového zdroje -->
                        <!-- <Data-source></Data-source> -->

                        <!-- popis profilu -->
                        <!-- <Description></Description> -->

                        <!-- režim autentizace do systému (jedna z hodnot sql, win, mix) -->
                        <!-- <Auth-mode>sql</Auth-mode> -->

                        <!-- typ poskytovatele databázového připojení (jedna z hodnot oledb, native) -->
                        <!-- <Provider-type>oledb</Provider-type> -->

                        <!-- příznak databáze v Unicode -->
                        <!-- <Unicode>false</Unicode> -->

                        <!-- příznak podpory pro Azure -->
                        <!-- <Azure>false</Azure> -->
                    <!-- </Profile> -->
                <!-- </Profiles> -->

                <!-- čas pro uzamčení neaktivní aplikace v sekundách (hodnota menší než 1 značí neuzamykání aplikace při neaktivitě) -->
                <!-- <Idle-lock-time></Idle-lock-time> -->

                <!-- čas pro ukončení neaktivní aplikace v sekundách (hodnota menší než 1 značí neukončování aplikace při neaktivitě) -->
                <!-- <Idle-close-time></Idle-close-time> -->

                <!-- příznak vynucení použití lokálního názvu pro identifikaci aktuálního počítače -->
                <!-- <Force-local-computer>true</Force-local-computer> -->

                <!-- explicitní název stanice pro aktuální instanci aplikace -->
                <!-- <Instance-comp-name></Instance-comp-name> -->

                <!-- časový limit pro přihlášení k databázi v sekundách -->
                <Connection-timeout>10</Connection-timeout>
                
                <!-- časový limit pro čekání na databázový zámek v sekundách -->
                <!--<Lock-timeout>10</Lock-timeout>-->
                
                <!-- časový limit pro vykonání databázového příkazu v sekundách -->
                <!--<Command-timeout>10</Command-timeout>-->
                
            </All>
        </Ginis>
    </Gordic>
</configuration>