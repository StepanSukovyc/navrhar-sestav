<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Gordic.Tools.LogViewer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
  <userSettings>
    <Gordic.Tools.LogViewer.Properties.Settings>
      <setting name="KeepLineBreaks" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="Encoding" serializeAs="String">
        <value>Default</value>
      </setting>
      <setting name="FilterError" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterInfo" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterWarning" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterDatabase" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterOther" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterGui" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterExclude" serializeAs="String">
        <value />
      </setting>
      <setting name="Delay" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="DelayLines" serializeAs="String">
        <value>2</value>
      </setting>
      <setting name="LastLogFolder" serializeAs="String">
        <value />
      </setting>
      <setting name="LastLogFileName" serializeAs="String">
        <value />
      </setting>
      <setting name="CutLineHeader" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="FilterDebug" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterFatal" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="SortByTime" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FilterTrace" serializeAs="String">
        <value>True</value>
      </setting>
    </Gordic.Tools.LogViewer.Properties.Settings>
  </userSettings>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
