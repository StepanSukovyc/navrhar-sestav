<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <!--ReportTempPath>c:\temp</ReportTempPath-->
        <!--ReporterJournal>c:\temp\InterpreterLog.txt</ReporterJournal-->
        <ReporterUseSafeCall>yes</ReporterUseSafeCall>
        <Dpi-debug>false</Dpi-debug>
        <!--
        <Dpi-aware>true</Dpi-aware>
        <Dpi-font-scale>false</Dpi-font-scale>
        <Dpi-form-scale>None</Dpi-form-scale>
        <Dpi-form-scale>Font</Dpi-form-scale>
        <Dpi-form-scale>Dpi</Dpi-form-scale>
        -->
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Gordic.General" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.Eko.Client" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.Adu.Interface" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.ControlsLogic.Interface" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.General.ApplicationClient" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.General.ApplicationInterface" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.Adu.Client" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.Report.Client" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.Eko.Interface" publicKeyToken="44B0E1E139828386" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Gordic.Report.Interface" publicKeyToken="44B0E1E139828386" culture="neutral" />
