<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <!--<Log>
                <Output-txt outputFile="C:\Temp\GSAUSU01.txt" incrementalWrite="true" autoFlush="true">
                    <Log-level-filter>
                        <Include>Error</Include>
                        <Include>Warning</Include>
                        <Include>Verbose</Include>
                    </Log-level-filter>
                </Output-txt>  
              </Log>-->
        <Culture>cs-CZ</Culture>
        <!--<Culture>cs-CZ</Culture>-->
        <!--<Culture>sk-SK</Culture>-->
        <!--ReportTempPath>c:\temp</ReportTempPath-->
        <Reporter-journal>c:\temp\InterpreterLog.txt</Reporter-journal>
        <Reporter-journal-erase>true</Reporter-journal-erase>
        <Reporter-debug>e:\NetTemp\gbw\GSAUSU-DEBUG.PAR</Reporter-debug>
        <ReporterUseSafeCall>yes</ReporterUseSafeCall>
        <Dpi-debug>false</Dpi-debug>
        <Dpi-debug>true</Dpi-debug>
        <Dpi-aware>true</Dpi-aware>
        <Dpi-font-scale>false</Dpi-font-scale>
        <Dpi-form-scale>Dpi</Dpi-form-scale>
      </All>
    </Ginis>
  </Gordic>
  <system.diagnostics>
    <trace autoflush="true" />
    <sources>
      <source name="System.Net">
        <listeners>
          <add name="MyTraceFile" />
          <add name="MyConsole" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="MyTraceFile" type="System.Diagnostics.TextWriterTraceListener" initializeData="c:\temp\System.Net.trace2.log" />
      <add name="MyConsole" type="System.Diagnostics.ConsoleTraceListener" />
    </sharedListeners>
    <switches>
      <add name="System.Net" value="Verbose" />
    </switches>
  </system.diagnostics>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>