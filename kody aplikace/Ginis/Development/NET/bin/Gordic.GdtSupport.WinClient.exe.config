<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IGdtSupport" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
        <!--<binding name="BasicHttpsBinding_IGdtSupport">
                    <security mode="Transport" />
                </binding>-->
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost/Gordic.GdtSupport.Server/GdtSupport.xamlx" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IGdtSupport" contract="GdtSupportServiceReference.IGdtSupport" name="BasicHttpBinding_IGdtSupport" />
      <!--<endpoint address="https://f-fiala.gordic.cz/Gordic.GdtSupport.Server/GdtSupport.xamlx"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpsBinding_IGdtSupport"
                contract="GdtSupportServiceReference.IGdtSupport" name="BasicHttpsBinding_IGdtSupport" />-->
    </client>
  </system.serviceModel>
</configuration>