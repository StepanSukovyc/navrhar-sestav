<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="GordicInstallService" type="System.Configuration.DictionarySectionHandler" />
  </configSections>
  <GordicInstallService>
    <add key="BinaryPath" value="d:\gc\net" />
    <add key="SourcePath" value="d:\gc\net" />
    <add key="WorkingPath" value="d:\gc\temp" />
    <add key="ErrorLogFile" value="d:\gc\logs\gincreator_error.log" />
    <add key="DebugLogFile" value="d:\gc\logs\gincreator_debug.log" />
  </GordicInstallService>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>