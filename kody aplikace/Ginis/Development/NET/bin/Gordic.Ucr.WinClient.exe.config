<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <xApp-server-url>http://kisskserver/Gordic.WebAppServerTEST/WebAppServer2.soap</xApp-server-url>
        <Log>
          <!--Output-txt outputFile="C:\Temp\GSAUCR01.txt" incrementalWrite="true" autoFlush="true">
                    <Log-level-filter>
                        <Include>Error</Include>
                        <Include>Warning</Include>
                        <Include>Verbose</Include>
                    </Log-level-filter>
                </Output-txt-->
          <!--Output-debug>
            <Log-level-filter>
              <Include>Error</Include>
              <Include>Warning</Include>
              <Include>Verbose</Include>
            </Log-level-filter>
          </Output-debug-->
        </Log>
        <!--Check-provider>false</Check-provider-->
        <Gin-presence-required>false</Gin-presence-required>
        <!--Startup-debug>true</Startup-debug-->
        <!--ReportTempPath>c:\temp</ReportTempPath-->
        <!--Reporter-gxl-debug>0</Reporter-gxl-debug-->
        <!--Reporter-journal>c:\temp\InterpreterLog.txt</Reporter-journal>
        <Reporter-journal-erase>true</Reporter-journal-erase-->
        <!--Reporter-debug>e:\NetTemp\gbw\DEBUG.PAR</Reporter-debug-->
        <!--ReporterUseSafeCall>yes</ReporterUseSafeCall-->
        <Reporter-schedule-path>\\gnet3\test\odloz\*WLOGIN*\aa</Reporter-schedule-path>
        <!--Reporter-lock-clipboard>1</Reporter-lock-clipboard-->
        <Dpi-debug>false</Dpi-debug>
        <Dpi-aware>true</Dpi-aware>
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>