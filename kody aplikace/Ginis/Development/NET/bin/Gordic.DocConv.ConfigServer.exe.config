<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Gordic.DocConv.ConfigServer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <appSettings>
    <add key="Vaults" value="File" />
    <add key="Profile" value="GSSDKS01" />
  </appSettings>
  <!--install-update-->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <userSettings>
    <Gordic.DocConv.ConfigServer.Properties.Settings>
      <setting name="TestFormLastTimeout" serializeAs="String">
        <value>30</value>
      </setting>
      <setting name="TestFormLastInputFilePath" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastOutputFile" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastTemplate" serializeAs="String">
        <value>COPY_TEST</value>
      </setting>
      <setting name="TestFormLastWsUrl" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastWsLogin" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastWsIdExt" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastWsUser" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastWsPassword" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastIxb" serializeAs="String">
        <value />
      </setting>
      <setting name="TestFormLastIxp" serializeAs="String">
        <value />
      </setting>
      <setting name="AppCulture" serializeAs="String">
        <value>cs-CZ</value>
      </setting>
      <setting name="MainFormLastWidth" serializeAs="String">
        <value>1054</value>
      </setting>
      <setting name="MainFormLastHeight" serializeAs="String">
        <value>780</value>
      </setting>
      <setting name="MainFormLastWindowState" serializeAs="String">
        <value>Normal</value>
      </setting>
    </Gordic.DocConv.ConfigServer.Properties.Settings>
  </userSettings>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
  <system.serviceModel>
    <bindings>
      <netNamedPipeBinding>
        <binding name="NetNamedPipeBinding_IGSignerDuplexService" maxBufferPoolSize="524288" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647">
          <readerQuotas maxDepth="128" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="4096" maxNameTableCharCount="2147483647" />
        </binding>
      </netNamedPipeBinding>
    </bindings>
    <client>
      <endpoint address="net.pipe://localhost/GSignerDuplexService/Server" binding="netNamedPipeBinding" bindingConfiguration="NetNamedPipeBinding_IGSignerDuplexService" contract="Gordic.Support.Sign.IGSignerDuplexService" name="NetNamedPipeBinding_IGSignerDuplexService">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>