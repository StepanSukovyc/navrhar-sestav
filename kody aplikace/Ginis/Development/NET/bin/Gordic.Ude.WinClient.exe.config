<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
    <section name="microsoft.web.services3" type="Microsoft.Web.Services3.Configuration.WebServicesConfiguration, Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
  </configSections>
  <microsoft.web.services3>
    <messaging>
      <transports>
        <add scheme="soap.tcp">
          <connectionLimit inbound="-1" outbound="-1" />
        </add>
      </transports>
    </messaging>
    <diagnostics>
      <trace enabled="false" input="c:\temp\wse-request.log.xml" output="c:\temp\wse-response.log.xml" />
    </diagnostics>
  </microsoft.web.services3>
  <Gordic>
    <Ginis>
      <GSAUDE02>
        <!-- *************************************************************************** -->
        <!-- ** všechny cesty je možné uvádět relativně k GSAUDE02.exe nebo absolutně ** -->
        <!-- *************************************************************************** -->
        <!-- XSLT budou použity k transformaxi XML na .html stránky; jejich defaultní podoba je v podadresáři Xslt aplikace -->
        <Cesta-k-xslt-sablonam>n:\ginis\489\dev\net\Gordic.Ude.WinClient\Skins\MMOP\Xslt</Cesta-k-xslt-sablonam>
        <!-- cesta k souborům a adresářům, které budou přímo nakopírovány do www výstupu (obsahuje Img, Css, ...) -->
        <Cesta-k-www-base>n:\ginis\489\dev\net\Gordic.Ude.WinClient\Skins\MMOP\WwwBase</Cesta-k-www-base>
        <!-- zde budou uloženy XML soubory s informacemi o vyvěšených dokumentech - slouží k odladění Xslt souborů -->
        <Cesta-k-xml-souborum>N:\a\ude02_mmop\xml</Cesta-k-xml-souborum>
        <!-- zde budou uloženy vygenerováné .html stránky a vyvěšené dokumenty k přesunu na www server -->
        <Cesta-k-www-vystupu>N:\a\ude02_mmop\www</Cesta-k-www-vystupu>
        <!-- identifikátor úložiště (úřední desky). Využívá se v případě několika naadministrovaných úředních desek (12-znakový identifikátor)-->
        <!--DEMOAWO0A05W - uloziste UDA
                        DEMOAWO0A0A7 - Úřední deska - nepublikační
                        DEMOAWO0A06R - Úřední deska - nepublikační
                -->
        <Ixs-ulz>DEMOAWO0A0A7</Ixs-ulz>
        <!-- kolik dní zobrazovat na úvodní stránce; default je 30 -->
        <Zobrazit-dni>30</Zobrazit-dni>
        <!-- generovat přírůstkově pouze posledních x dní (týká se html stránek detailů a jejich příloh); 0 = generovat vše; -->
        <Generovat-dni>30</Generovat-dni>
        <!-- archiv true=zobrazit;false=nezobrazovat -->
        <Zobrazit-archiv>true</Zobrazit-archiv>
        <!-- povolit chybu při stahování z úložiště -->
        <!-- true=při chybě se bude pokračovat v generování stránek, ale musí se počítat s tím, že soubor při prohlížení úřední desky nepude zobrazit (leda že by zůstal na disku web serveru z předchozího generování) -->
        <!-- false=při chybě program skončí -->
        <Povolit-chybu-uloziste>true</Povolit-chybu-uloziste>
        <!-- zda se mají plnit tabulky pro OPEN DATA -->
        <!-- false = neplnit (default); true = plnit -->
        <Plnit-open-data>true</Plnit-open-data>
        <!-- www root pro generované odkazy v rámci OPEN DATA, tj. tam kam se pak kopíruje nagenerovaný web (např. http://www.mesto.cz/deska) -->
        <Open-data-www-root>http://www.mesto.cz/deska</Open-data-www-root>
      </GSAUDE02>
      <All>
        <!-- výchozí databázový profil -->
        <!--<Default-profile></Default-profile>-->
        <!-- URL autorizační služby -->
        <!-- <Auth-service-url></Auth-service-url> -->
        <!-- URL alternativní autorizační služby -->
        <!-- <Auth-service-url2></Auth-service-url2> -->
        <!-- časový limit pro dokončení požadavku na autorizační službu v sekundách -->
        <!-- <Auth-service-timeout>30</Auth-service-timeout> -->
        <!-- typ autorizace do GINISu (jedna z hodnot ginis, windows, anonymous, public) -->
        <!-- <Auth-type>ginis</Auth-type> -->
        <!-- kultura pro lokalizaci aplikace -->
        <!-- <Culture>cs-CZ</Culture> -->
        <!-- seznam povolených databázových profilů -->
        <!-- <Allowed-profiles></Allowed-profiles> -->
