        <!-- <Unicode>false</Unicode> -->
        <!-- příznak podpory pro Azure -->
        <!-- <Azure>false</Azure> -->
        <!-- </Profile> -->
        <!-- </Profiles> -->
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>