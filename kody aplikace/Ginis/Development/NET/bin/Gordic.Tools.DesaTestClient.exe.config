<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <appSettings>
    <!-- ============ Konfigurace konektoru DESA ================================= -->
    <!-- URL k rozhraním DESA -->
    <add key="DESA__SipSubmissionServiceUrl" value="http://srv-desa-apltest.nt1.ku.ji.cz:8080/dea-frontend/ws/SIPSubmissionService" />
    <add key="DESA__SipOutputServiceUrl" value="http://srv-desa-apltest.nt1.ku.ji.cz:8080/dea-frontend/ws/SIPOutput-test" />
    <add key="DESA__DEAAdminServiceUrl" value="http://srv-desa-apltest.nt1.ku.ji.cz:8080/dea-frontend/ws/DEA-test" />
    <!-- autentizace k webovému serveru - basic -->
    <add key="DESA__WsLogin" value="gkos" />
    <add key="DESA__WsPwd" value="ws" />
    <!-- identifikace v DESA -->
    <add key="DESA__DesaUserLogin" value="vkos" />
    <add key="DESA__ProducerID" value="15" />
    <!-- Logování - hodnoty: 0|1 -->
    <add key="DESA__Log" value="1" />
    <!-- Upravení HTTP hlaviček pro ESB (TescoSW) - hodnoty: 0|1 -->
    <add key="DESA__AddAuthHttpHeader" value="0" />
    <!-- ============ Konfigurace konektoru TranSoft ================================= -->
    <!-- URL k rozhraním -->
    <add key="eSAT__DZUrl" value="http://webtest.cs.mfcr.cz/Spis/WebServiceAuth/DatoveZpravy.asmx" />
    <add key="eSAT__CRSUrl" value="http://webtest.cs.mfcr.cz/CRSWS-AUTH_ZR/v2/CRS.asmx" />
    <!-- autentizace k webovému serveru - windows -->
    <add key="eSAT__Login" value="CS\ApplGINIS" />
    <add key="eSAT__Pwd" value="Celnice12345@" />
    <!-- ============ Konfigurace konektoru Dopis On-line a HKP ================================= -->
    <!-- URL k rozhraní ČP -->
    <add key="Posta__DOLUrl" value="https://online3.postservis.cz" />
    <add key="Posta__DOLTestLogin" value="dreplech" />
    <add key="Posta__DOLTestPwd" value="dreplech" />
    <add key="Posta__ArchivePath" value="D:\TMP-GINIS" />
  </appSettings>
</configuration>