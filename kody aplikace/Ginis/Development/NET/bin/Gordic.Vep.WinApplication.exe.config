<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
  <Gordic>
    <Ginis>
      <All>
        <Log>
          <!-- nastavení aplikačního logu do txt souboru -->
          <!-- <Output-txt outputFile="c:\temp\GSAVEP01.log.txt" maxSize="100"/> -->
          <!-- nastavení aplikačního logu do txt souboru s veškerými podrobnostmi -->
          <!-- <Output-txt outputFile="c:\temp\GSAVEP01.log.txt" logLevel = "+Verbose" maxSize="100"/> -->
        </Log>
        <Dpi-debug>false</Dpi-debug>
      </All>
    </Ginis>
  </Gordic>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>
</configuration>