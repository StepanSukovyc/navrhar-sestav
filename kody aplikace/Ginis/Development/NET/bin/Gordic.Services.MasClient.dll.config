<?xml version="1.0"?>
<configuration>
    <configSections>
        <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General"/>
        <section name="microsoft.web.services3" type="Microsoft.Web.Services3.Configuration.WebServicesConfiguration, Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    </configSections>
    <microsoft.web.services3>
        <messaging>
            <transports>
                <add scheme="soap.tcp">
                    <connectionLimit inbound="-1" outbound="-1"/>
                </add>
            </transports>
        </messaging>
        <diagnostics>
            <!--<trace enabled="true" input="C:\MasTest\GSSMAS01.request.log.xml" output="C:\MasTest\GSSMAS01.response.log.xml"/>-->
        </diagnostics>
    </microsoft.web.services3>
    <system.net>
        <mailSettings>
            <smtp deliveryMethod="network">
                <!-- nastavení SMTP serveru pro odesílání e-mailů -->
                <!-- <network host="localhost" port="25" defaultCredentials="true" /> -->
                <!-- <network host="192.168.0.10" port="25" userName="jkuttich" password="heslo123" /> -->
                <!-- <network host="smtp.gmail.com" port="25" userName="jan.kuttich@gmail.com" password="zichlinek27" /> -->
                <!-- <network host="smtp.seznam.cz" port="25" userName="jan.kuttich@email.cz" password="zichlinek27" /> -->
            </smtp>
        </mailSettings>
    </system.net>
    <Gordic>
        <Ginis>
          <GSSGSL01>
            <!-- podrobnost logování, přípustné hodnoty jsou Off, Errors, All -->
            <Event-log>All</Event-log>

            <!-- interval pro zpracování záznamů (hh:min:sec) maximum (23:59:59)-->
            <Timer-period>00:00:45</Timer-period>

            <!-- soubor kam se zapisuje log ze zpracovani -->
            <Execution-log-file>C:\Temp\GSSGSL01.log</Execution-log-file>

            <!-- velikost souboru v Bytes kam se zapisuje zpracovaci log -->
            <Execution-logfile-size>10000000</Execution-logfile-size>

            <!-- typy souboru ktere lze zpracovat (oddelovat carkou - *.tif, *.pdf) -->
            <Allowed-file-types>*.tif, *.pdf, *.png</Allowed-file-types>

            <!-- čas počátku režimu nečinnosti ve formátu hh:mm -->
            <Dormant-mode-from>22:00</Dormant-mode-from>

            <!-- čas ukončení režimu nečinnosti ve formátu hh:mm -->
            <Dormant-mode-to>06:00</Dormant-mode-to>

            <!-- restart služby by ukončení času nečinnosti (0-NE; 1-ANO) -->
            <Restar-after-dormant>1</Restar-after-dormant>

            <!-- vynuceny restart po uplynuti intervalu (min 0-1440) kdy je system bez odezvy-->
            <Force-restart-after>60</Force-restart-after>

            <!-- emailová adresa kam se má posílat zpráva o chybě při zpracování (adresy v seznamu musí být odděleny středníkem) -->
            <Send-errors-to>martin_halik@gordic.cz</Send-errors-to>
            
            <!-- odeslání emailu při kterékoliv chybě zpracování OCR (0-NE; 1-ANO) -->
            <Send-errors-when-ocr-failed>1</Send-errors-when-ocr-failed>
            
            <!-- odeslání emailu při detekci nezpracovávaného souboru (0-NE; 1-ANO) -->
            <Send-errors-when-badfiletype>0</Send-errors-when-badfiletype>

            <!-- odeslání emailu při detekci nevalidniho identifikatoru (0-NE; 1-ANO) -->
            <Send-errors-when-failedPID>0</Send-errors-when-failedPID>

            <!-- odeslání emailu při detekci odmitnuteho zpracování (0-NE; 1-ANO) -->
            <Send-errors-when-refusedPID>0</Send-errors-when-refusedPID>

            <!-- odeslání emailu při chybě během zpracování emailu(0-NE; 1-ANO) -->
            <Send-errors-when-emailfailed>0</Send-errors-when-emailfailed>

            <!-- příznak zajištění monitorování provozu služby -->
            <Service-monitoring>false</Service-monitoring>

            <!-- prideleni naskenovanych dokumentu na funkcni misto podle lokace  (Cest;IXSFUN)-->
            <!--<Lok-fun-def>
              <PathFun>Path1;IXSFUN1</PathFun>
              <PathFun>Path2;IXSFUN2</PathFun>
            </Lok-fun-def>-->

            <!-- pridělení pracovišť RAK (IXSFUN)-->
            <!--<Rak-def>
              <IxsFun>IXSFUN1</IxsFun>
              <IxsFun>IXSFUN2</IxsFun>
            </Rak-def>-->

          </GSSGSL01>
            <GSSMAS01>
              <!-- podrobnost logování, přípustné hodnoty jsou Off, Errors, All -->
              <Event-log>All</Event-log>

              <!-- interval pro zpracování záznamů (hh:min:sec)-->
              <Timer-period>00:00:40</Timer-period>

              <!-- soubor kam se zapisuje log ze zpracovani -->
              <Execution-log-file>C:\MasTest\Log\GSSMAS01.log</Execution-log-file>

              <!-- velikost souboru v Bytes kam se zapisuje zpracovaci log -->
              <Execution-logfile-size>10000000</Execution-logfile-size>

              <!-- typy souboru ktere lze zpracovat (oddelovat carkou - *.tif, *.pdf) -->
              <Allowed-file-types>*.tif, *.pdf</Allowed-file-types>

              <!-- čas počátku režimu nečinnosti ve formátu hh:mm -->
              <Dormant-mode-from>20:10</Dormant-mode-from>

              <!-- čas ukončení režimu nečinnosti ve formátu hh:mm -->
              <Dormant-mode-to>20:13</Dormant-mode-to>
              
              <!-- restart služby by ukončení času nečinnosti (0-NE; 1-ANO) -->
              <Restar-after-dormant>1</Restar-after-dormant>

              <!-- vynuceny restart po uplynuti intervalu (min 0-1440) kdy je system bez odezvy-->
              <Force-restart-after>3</Force-restart-after>

              <!-- emailová adresa kam se ma posílat zpráva o chybě při zpracování -->
              <Send-errors-to>martin_halik@gordic.cz ; martin_halik@gordic.cz</Send-errors-to>

              <!-- odeslání emailu při detekci nezpracovávaného souboru (0-NE; 1-ANO) -->
              <Send-errors-when-badfiletype>1</Send-errors-when-badfiletype>

              <!-- odeslání emailu při detekci nevalidniho identifikatoru (0-NE; 1-ANO) -->
              <Send-errors-when-failedpid>1</Send-errors-when-failedpid>

              <!-- odeslání emailu při detekci odmitnuteho zpracování (0-NE; 1-ANO) -->
              <Send-errors-when-refusedpid>1</Send-errors-when-refusedpid>

              <!-- odeslání emailu při chybě během zpracování emailu(0-NE; 1-ANO) -->
              <Send-errors-when-emailfailed>1</Send-errors-when-emailfailed>

              <!-- příznak zajištění monitorování provozu služby -->
              <Service-monitoring>true</Service-monitoring>
              <!-- cesta k souboru sloužícímu pro monitorování běhu služby. Kontrola se provádí v intervalech daných pomocí elementu Timer-period -->
              <Service-run-file>D:\gsl_mon.txt</Service-run-file>
              
              <!-- prideleni naskenovanych dokumentu na funkcni misto podle lokace  (Cest;IXSFUN)-->
              <Lok-fun-def>
                  <PathFun>C:\tmp\MASHATI\;DEMOSF009Q58</PathFun>
                  <!--<PathFun>Path2;IXS2</PathFun>-->
              </Lok-fun-def>
            
          </GSSMAS01>
            <All>
                <!-- výchozí databázový profil -->
                <Default-profile>d388vvs7</Default-profile>

                <!-- URL autorizační služby -->
                <Auth-service-url>http://M-HALIK3:8081/Auth</Auth-service-url>

                <!-- URL alternativní autorizační služby -->
                <!-- <Auth-service-url>soap.tcp://vento/Auth</Auth-service-url> -->

                <!-- typ autorizace do GINISu (jedna z hodnot ginis, windows, anonymous, public) -->
                <Auth-type>windows</Auth-type>

                <!-- kultura pro lokalizaci aplikace -->
                 <Culture>cs-CZ</Culture> 
                <!--<Culture>sk-SK</Culture>-->

                <!-- seznam povolených databázových profilů -->
                <!-- <Allowed-profiles></Allowed-profiles> -->

                <!-- příznak povinného zobrazení přihlašovacího dialogu -->
                <!-- <Force-login>true</Force-login> -->

                <!-- režim přihlášení (1=řádné přihlášení, 2=zástup, 3=kombinace řádného přihlášení a zástupu, 4=automatické přihlášení) -->
                <!-- <Default-rezim>1</Default-rezim> -->

              <!-- nastavení logovani -->
              <!--<Log>
                --><!--<Output-xml format="NoHeader" outputFile="c:\tmp\GSSMAS01.log.xml" incrementalWrite="true" autoFlush="true"></Output-xml>--><!--
                --><!--<Output-debug format="NoHeader"></Output-debug>--><!--
                --><!--<Output-txt format="NoHeader" outputFile="c:\MasTest\GSSMAS01.log.txt" incrementalWrite="true" autoFlush="true"></Output-txt>--><!--
              </Log>-->

              <!-- nastavení aplikačního logu do souboru -->
                <Log>
                    <!--<Output-xml outputFile="c:\tmp\GSSMAS01.log.xml" incrementalWrite="true" autoFlush="true">
                        
                        <Log-id-filter>
                            <Include use="RegExpression">GSSMAS01</Include>
                        </Log-id-filter>
                        <Log-id-filter>
                            <Include use="Wildcard">*</Include>
                            <Exclude use="Wildcard">db*</Exclude>
                        </Log-id-filter>
                        <Log-level-filter>
                            <Include>Error</Include>
                            <Include>Warning</Include>
                            <Include>Info</Include>
                            <Include>Verbose</Include>
                        </Log-level-filter>
                    </Output-xml>-->
                  <Output-txt outputFile="c:\MasTest\LOG\GSSMAS01.log.txt" incrementalWrite="true" autoFlush="true" maxSize="5">
                        <!--<Log-id-filter>
                            <Include use="RegExpression">GSSMAS01</Include>
                        </Log-id-filter>-->
                        <Log-id-filter>
                            <Include use="Wildcard">*</Include>
                            <Exclude use="Wildcard">db*</Exclude>
                        </Log-id-filter>
                        <Log-level-filter>
                            <Include>Error</Include>
                            <Include>Warning</Include>
                            <Include>Info</Include>
                            <Include>Verbose</Include>
                        </Log-level-filter>
                    </Output-txt>
                </Log>

                <!-- adresář pro dočasné soubory generátoru sestav -->
                <!-- <Reporter-temp-path>c:\temp</Reporter-temp-path> -->

                <!-- cesta pro umístění žurnálu generátoru sestav -->
                <!-- <Reporter-journal>c:\temp\reporter.log.txt</Reporter-journal> -->

                <!-- příznak kontroly společných Win32 knihoven při startu aplikace -->
                <!-- <Gin-presence-required>false</Gin-presence-required> -->

                <!-- příznak přítomnosti výpisu zásobníku v textu výjimek -->
                <!--<Exception-stack-trace>true</Exception-stack-trace>-->
            </All>
        </Ginis>
    </Gordic>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup></configuration>
