<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <GSAMPD01>
        <Root-path>N:\Data\Mpd</Root-path>
      </GSAMPD01>
      <All>
        <Auth-service-url>https://n-jkuttich4:1234/auth</Auth-service-url>
        <Log>
          <Output-txt outputFile="c:\tmp\GSAMPD01_console.log.txt">
            <Log-id-filter>
              <Include use="Wildcard">*</Include>
              <Exclude use="Wildcard">Gordic.Support.Database.GDbLog*</Exclude>
            </Log-id-filter>
            <Log-message-filter>
              <Include use="Wildcard">mpd*</Include>
              <Exclude use="Wildcard">mpdsec*</Exclude>
            </Log-message-filter>
            <Log-level-filter>
              <Include>Error</Include>
              <Include>Warning</Include>
              <Include>Info</Include>
              <!--<Include>Verbose</Include>-->
            </Log-level-filter>
          </Output-txt>
        </Log>
        <Backup-log-period>1</Backup-log-period>
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>