<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <!--Startup-debug>true</Startup-debug-->
        <!--ReportTempPath>c:\temp</ReportTempPath-->
        <ReporterJournal>c:\temp\InterpreterLog.txt</ReporterJournal>
        <Reporter-debug>e:\NetTemp\gbw\DEBUG.PAR</Reporter-debug>
        <ReporterUseSafeCall>yes</ReporterUseSafeCall>
        <Reporter-schedule-path>\\gnet1\test\odloz</Reporter-schedule-path>
        <Dpi-debug>false</Dpi-debug>
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
</configuration>