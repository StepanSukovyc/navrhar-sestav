<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <!--Check-provider>false</Check-provider-->
        <Dpi-debug>false</Dpi-debug>
        <!-- výchozí databázový profil -->
        <!--<Default-profile>local374</Default-profile>-->
        <!-- URL autorizační služby -->
        <!--<Auth-service-url>soap.tcp://n-jkuttich/Auth</Auth-service-url>-->
        <!-- URL alternativní autorizační služby -->
