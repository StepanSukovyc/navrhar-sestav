<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
    <section name="microsoft.web.services3" type="Microsoft.Web.Services3.Configuration.WebServicesConfiguration, Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
  </configSections>
  <microsoft.web.services3>
    <messaging>
      <transports>
        <add scheme="soap.tcp">
          <connectionLimit inbound="-1" outbound="-1" />
        </add>
      </transports>
    </messaging>
    <security>
      <securityTokenManager>
        <add localName="UsernameToken" type="Gordic.Tools.WsClient.GWseTokenManager3, Gordic.Tools.WsClient" namespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd" />
      </securityTokenManager>
    </security>
    <diagnostics>
      <trace enabled="false" input="c:\temp\wse-request.log.xml" output="c:\temp\wse-response.log.xml" />
    </diagnostics>
  </microsoft.web.services3>
  <appSettings>
    <!-- URL webové služby, např. http://JmenoServeru/gordic/ginis/ws/mud01/mud.asmx -->
    <add key="WsMudApp-UrlWeboveSluzby" value="http://j-vacha/gordic/ginis/ws/478/mud01/mud.asmx" />
    <!-- Alternativní URL, např. http://JmenoServeru2/gordic/ginis/ws/mud01/mud.asmx -->
    <add key="WsMudApp-UrlWeboveSluzby2" value="" />
    <!-- Jméno uživatele včetně ext. systému, např. ABCD12345678\uzivatel-->
    <add key="WsMudApp-Uzivatel1" value="A446AIE0A02M\testersu" />
    <!-- Heslo uživatele – možno zašifrovat voláním programu s jedním parametrem (tj. heslem) -->
    <add key="WsMudApp-Uzivatel2" value="testersu" />
    <!-- Verze WSE, použijte konstantu 3.0 -->
    <add key="WsMudApp-WSEnhancements" value="3.0" />
    <!-- Způsob zabezpečení hesla, možnosti: hashed | plain-text | http-basic | http-digest -->
    <add key="WsMudApp-ZabezpeceniOdesilaniHesla" value="hashed" />
    <!-- Maximální počet položek dokladu MUD, při větším počtu bude vrácena výjimka -->
    <add key="WsMudApp-MaxPocetPolozek" value="510" />
    <!-- Timeout v sekundách -->
    <!--   jak dlouho bude klient čekat na odpověď ze serveru -->
    <!--   musí být delší než timeout na serveru viz web.config webových služeb -->
    <!-- hodnota = 0 ... bude čekat dokud server neodpoví, tj. bez časového omezení na klientovi (doporučeno) -->
    <!-- hodnota > 0 ... bude čekat příslušný počet sekund, max. je 32767 tj. 9 hod. 6 min 7 s.-->
    <add key="WsMudApp-Timeout" value="0" />
    <!-- Zda zapisovat informace do log souboru GSAWSM01_YYYYMMDD.log; možné hodnoty jsou true a false -->
    <add key="WsMudApp-PodrobnyLog" value="false" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>