<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IAutSupport" />
        <binding name="BasicHttpsBinding_IAutSupport">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost/Gordic.GdtSupport.Server/AutSupport.xamlx" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IAutSupport" contract="ServiceReference1.IAutSupport" name="BasicHttpBinding_IAutSupport" />
      <endpoint address="https://f-fiala2.gordic.cz/Gordic.GdtSupport.Server/AutSupport.xamlx" binding="basicHttpBinding" bindingConfiguration="BasicHttpsBinding_IAutSupport" contract="ServiceReference1.IAutSupport" name="BasicHttpsBinding_IAutSupport" />
    </client>
  </system.serviceModel>
</configuration>