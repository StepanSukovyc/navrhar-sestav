<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <!--<App-server-url>http://127.0.0.1/Gordic.App.WsClient/AppServer.ashx#GIN_VYP</App-server-url>-->
        <Log>
          <Output-txt outputFile="C:\Temp\GSAVYP01.txt" incrementalWrite="true" autoFlush="true">
            <Log-level-filter>
              <Include>Info</Include>
            </Log-level-filter>
          </Output-txt>
        </Log>
        <!--<Culture>sk-SK</Culture>-->
        <!--ReportTempPath>c:\temp</ReportTempPath-->
        <Reporter-journal>c:\temp\InterpreterLog.txt</Reporter-journal>
        <Reporter-journal-erase>true</Reporter-journal-erase>
        <Reporter-debug>e:\NetTemp\gbw\GSASUD-DEBUG.PAR</Reporter-debug>
        <ReporterUseSafeCall>yes</ReporterUseSafeCall>
        <Dpi-debug>false</Dpi-debug>
        <Dpi-aware>true</Dpi-aware>
        <Dpi-font-scale>false</Dpi-font-scale>
        <Dpi-form-scale>Dpi</Dpi-form-scale>
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>