<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
  </startup>
  <appSettings>
    <!-- Příznak, zda se mají vypisovat hlavičky. Očekávaná hondota je 0 nebo 1-->
    <!-- <add key="showheader" value="1"/>-->
    <add key="showheader" value="0" />
    <!-- Zde se uvádí filtrační podmínky pro výpis řádků. 
         Pokud je položka prázdná, potom se podle takové položky nefiltruje.
         Položka může obsahovat seznam hodnot oddělených čárkou, potom se jedná o filtr typu OR 
         
         Ukázka položek, podle kterých lze filtrovat:
            [[-GLog- id:dbcommand t:2018-04-18 11:12:02.79 dt:0,4731 lev:Verbose lpc:4655 us:Účet Servisní pid:1612 tid:32 f:GWSRZP01 mes: xxx ]]
    -->
    <!-- <add key="id" value="dbprocedure,common,dbsptrace"/> -->
    <add key="id" value="" />
    <!-- <add key="lev" value="Verbose,Info"/> -->
    <add key="lev" value="" />
    <add key="lpc" value="" />
    <add key="us" value="" />
    <add key="pid" value="" />
    <add key="tid" value="" />
    <!-- <add key="f" value="GWSRZP01"/>-->
    <add key="f" value="" />
    <!-- Položka mes se netestuje na přesnou shodu ale pouze na výskyt substringu -->
    <!-- <add key="mes" value="spg_rzp_main03,FillDataTable"/> -->
    <add key="mes" value="" />
  </appSettings>
</configuration>