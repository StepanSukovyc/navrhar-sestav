<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections></configSections>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="GSignerWcfServiceBehavior">
          <serviceDebug includeExceptionDetailInFaults="true" />
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
          <serviceSecurityAudit auditLogLocation="Application" serviceAuthorizationAuditLevel="SuccessOrFailure" messageAuthenticationAuditLevel="SuccessOrFailure" />
          <serviceThrottling maxConcurrentCalls="1000" maxConcurrentSessions="100" maxConcurrentInstances="1000" />
        </behavior>
      </serviceBehaviors>
      <endpointBehaviors>
        <behavior name="EndpointBehavior">
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <bindings>
      <netNamedPipeBinding>
        <binding name="NetNamedPipeBinding_IGSignerDuplexService" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" transactionFlow="false" transferMode="Buffered" transactionProtocol="OleTransactions" hostNameComparisonMode="StrongWildcard" maxReceivedMessageSize="2147483647" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxConnections="10">
          <readerQuotas maxDepth="32" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="Transport">
            <transport protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netNamedPipeBinding>
    </bindings>
    <!--WCF service client connection configuration (for duplex service)-->
    <client>
      <endpoint address="net.pipe://localhost/GSignerDuplexService/Client" binding="netNamedPipeBinding" bindingConfiguration="NetNamedPipeBinding_IGSignerDuplexService" behaviorConfiguration="EndpointBehavior" contract="Gordic.Support.Sign.IGSignerDuplexService" />
    </client>
    <!--WCF service configuration-->
    <services>
      <service behaviorConfiguration="GSignerWcfServiceBehavior" name="Gordic.Support.Sign.GSignerDuplexService">
        <endpoint address="net.pipe://localhost/GSignerDuplexService/Server" binding="netNamedPipeBinding" bindingConfiguration="NetNamedPipeBinding_IGSignerDuplexService" contract="Gordic.Support.Sign.IGSignerDuplexService">
          <identity>
            <dns value="localhost" />
          </identity>
        </endpoint>
        <host>
          <baseAddresses>
            <add baseAddress="net.pipe://localhost/GSignerDuplexService/Server" />
          </baseAddresses>
        </host>
      </service>
    </services>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--WCF service logging-->
  <!--<system.diagnostics>
    <sources>
      <source name="System.ServiceModel" switchValue="Information, ActivityTracing" propagateActivity="false">
        <listeners>
          <add name="traceListener" />
        </listeners>
      </source>
      <source name="System.ServiceModel.MessageLogging">
        <listeners>
          <add name="traceListener" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="traceListener" type="System.Diagnostics.XmlWriterTraceListener" initializeData="C:\Log\WcfTraceServer.svclog" />
    </sharedListeners>
  </system.diagnostics>-->
</configuration>