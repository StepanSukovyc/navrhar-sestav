<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <Reporter-debug>c:\temp\DEBUG.PAR</Reporter-debug>
        <Reporter-journal>c:\temp\reporter.log.txt</Reporter-journal>
        <Startup-debug>true</Startup-debug>
        <!--Startup-debug>true</Startup-debug-->
        <!--ReportTempPath>c:\temp</ReportTempPath-->
        <!--ReporterJournal>c:\temp\InterpreterLog.txt</ReporterJournal-->
        <!--Reporter-debug>e:\NetTemp\gbw\DEBUG.PAR</Reporter-debug-->
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
  </startup>
</configuration>