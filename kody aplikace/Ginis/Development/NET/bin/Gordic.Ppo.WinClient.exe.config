<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <Gordic>
    <Ginis>
      <All>
        <!--<Log>
                <Output-txt outputFile="C:\Temp\GSASPI01.txt" incrementalWrite="true" autoFlush="true">
                    <Log-level-filter>
                        <Include>Error</Include>
                        <Include>Warning</Include>
                        <Include>Verbose</Include>
                    </Log-level-filter>
                </Output-txt>  
              </Log>-->
        <Log>
          <Output-txt outputFile="C:\Temp\GSAPPO01.txt" incrementalWrite="true" autoFlush="true" maxSize="50">
            <Log-id-filter>
              <Include use="Wildcard">*</Include>
              <Exclude use="Wildcard">db*</Exclude>
            </Log-id-filter>
            <Log-level-filter>
              <Include>Error</Include>
              <Include>Warning</Include>
              <Include>Info</Include>
              <Include>Verbose</Include>
            </Log-level-filter>
          </Output-txt>
        </Log>
        <Culture>cs-CZ</Culture>
        <!--<ReportTempPath>c:\temp</ReportTempPath>
        <Reporter-journal>c:\temp\InterpreterLog.txt</Reporter-journal>-->
        <Reporter-journal-erase>true</Reporter-journal-erase>
        <!--<Reporter-debug>e:\NetTemp\gbw\GSAEPK-DEBUG.PAR</Reporter-debug>-->
        <ReporterUseSafeCall>yes</ReporterUseSafeCall>
      </All>
    </Ginis>
  </Gordic>
</configuration>