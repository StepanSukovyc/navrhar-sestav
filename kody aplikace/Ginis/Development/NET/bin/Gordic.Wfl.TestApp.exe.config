<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
  </startup>
  <Gordic>
    <Ginis>
      <All>
        <Culture>cs-CZ</Culture>
        <Dpi-debug>false</Dpi-debug>
      </All>
    </Ginis>
  </Gordic>
</configuration>