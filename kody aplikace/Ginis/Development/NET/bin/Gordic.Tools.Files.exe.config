<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Vaults" value="DPAPIFile" />
    <add key="Vaults" value="File" />
    <add key="Profile" value="GSSDKS01" />
    <add key="SbbLicenseKeyType" value="LONG" />
