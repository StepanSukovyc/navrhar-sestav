<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <!-- <ReportTempPath>c:\temp</ReportTempPath>-->
        <!-- <ReporterJournal>c:\temp\InterpreterLog.txt</ReporterJournal>-->
        <ReporterUseSafeCall>yes</ReporterUseSafeCall>
        <!-- Zapnuti logovani sestavy. Popis od J.Gotha -->
        <!--<Reporter-journal>c:\temp\reporter.log.txt</Reporter-journal>-->
        <!--<Reporter-journal-erase>false</Reporter-journal-erase>-->
        <!--<Reporter-debug>c:\temp\DEBUG.PAR</Reporter-debug>-->
        <Dpi-debug>false</Dpi-debug>
        <!--
        <Dpi-debug>true</Dpi-debug>
        <Dpi-aware>true</Dpi-aware>
        <Dpi-font-scale>false</Dpi-font-scale>
        <Dpi-form-scale>None</Dpi-form-scale>
        <Dpi-form-scale>Font</Dpi-form-scale>
        <Dpi-form-scale>Dpi</Dpi-form-scale>
        -->
      </All>
    </Ginis>
  </Gordic>
  <!--
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Gordic.WinForms.Gui" publicKeyToken="44B0E1E139828386" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-468.1.0.0" newVersion="468.1.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
  </runtime>
        -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>