<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="GordicInstallService" type="System.Configuration.DictionarySectionHandler" />
  </configSections>
  <connectionStrings>
    <add name="Gordic.Develop.Properties.Settings.gdevConnectionString" connectionString="Data Source=SRV-GSQL,1900;Initial Catalog=gdev;Persist Security Info=True;Integrated Security=SSPI;Connection Timeout=300" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <GordicInstallService>
    <add key="InstallerService" value="tcp://localhost:8874" />
