    <add key="WorkingPath" value="N:\InstallServer\workdir" />
    <add key="ActiveWorkdirCount" value="5" />
    <add key="StoragePath" value="N:\InstallServer\packages.speedtest" />
    <add key="AutomatPath" value="N:\InstallServer\publish" />
    <add key="LocCachePath" value="N:\InstallServer\temp" />
    <add key="WixPath" value="N:\Ginis\Development\NET\Gordic.Develop.InstallerService\ExternalExe\WiX" />
    <add key="CustomerConfigPath" value="N:\Ginis\Development\NET\Gordic.Develop.InstallerService\CustomerConfig" />
    <add key="SvnUrlBase" value="https://svn.gordic.cz/G1/{location}/NET" />
    <add key="SvnUserName" value="" />
