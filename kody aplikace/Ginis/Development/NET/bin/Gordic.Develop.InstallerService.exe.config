    <add key="SignCertificatePassword" value="@N:\InstallServer\certificates\debugpassword.txt" />
    <add key="MailCertificate" value="" />
    <add key="MailCertificatePassword" value="" />
    <add key="MailSMTPClient" value="mailhost.gordic.cz" />
    <add key="AssemblyLinkerPath" value="N:\Ginis\Development\NET\Gordic.Develop.InstallerService\ExternalExe\Res\al.exe" />
    <add key="AssemblySignatureKeyPath" value="N:\InstallServer\certificates\Gordic.snk" />
    <add key="ResgenPath" value="N:\Ginis\Development\NET\Gordic.Develop.InstallerService\ExternalExe\Res\ResGen.exe" />
