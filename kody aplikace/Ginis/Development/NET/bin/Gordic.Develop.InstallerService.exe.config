    <add key="SignTool" value="N:\Ginis\Development\NET\Gordic.Develop.InstallerService\ExternalExe\SignTool\signtool.exe" />
    <!--add key="SignTool" value="N:\Development\NET\Gordic.Develop.InstallerService\EXTERNALEXE\OSSLSignCode\osslsigncode.exe" /-->
