<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IGdtExtSupport" />
                <binding name="BasicHttpsBinding_IGdtExtSupport">
                    <security mode="Transport" />
