<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="SignService" value="https://gsign.gordic.cz" />
    <add key="SignServiceAuthCAThumbprint" value="" />
    <add key="SignTool" value="" />
    <add key="SignTimestampServers" value="http://timestamp.digicert.com;http://timestamp.verisign.com/scripts/timstamp.dll;http://timestamp.comodoca.com/authenticode" />
  </appSettings>
</configuration>