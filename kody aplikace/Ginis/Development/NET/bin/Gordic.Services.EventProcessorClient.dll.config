<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General"/>
        <section name="microsoft.web.services3" type="Microsoft.Web.Services3.Configuration.WebServicesConfiguration, Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    </configSections>
    <microsoft.web.services3>
        <security>
            <securityTokenManager>
                <add localName="UsernameToken" type="Gordic.Tools.WsClient.GWseTokenManager3, Gordic.Tools.WsClient" namespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"/>
            </securityTokenManager>
        </security>
    </microsoft.web.services3>
    <system.net>
        <mailSettings>
            <!-- <smtp deliveryMethod="network"> -->
                <!-- nastavení SMTP serveru pro odesílání e-mailů -->
                <!-- <network host="localhost" port="25" defaultCredentials="true" /> -->
                <!-- <network host="192.168.0.10" port="25" userName="jkuttich" password="xxx" /> -->
                <!-- <network host="smtp.gmail.com" port="25" userName="jan.kuttich@gmail.com" password="xxx" /> -->
                <!-- <network host="smtp.seznam.cz" port="25" userName="jan.kuttich@email.cz" password="xxx" /> -->
            <!-- </smtp> -->
        </mailSettings>
    </system.net>
    <Gordic>
        <Ginis>
            <GSSZUD01>
                <!-- podrobnost logování, přípustné hodnoty jsou Off, Errors, All -->
                <Event-log>All</Event-log>

                <!-- interval pro načítání záznamů z databáze v sekundách -->
                <Timer-period>20</Timer-period>
                
                <!-- počet zpráv načítaných najenou z databázové fronty událostí -->
                <Queue-capacity>10</Queue-capacity>

                <!-- počet současně zpracovávaných událostí -->
                <Processor-threads>1</Processor-threads>
                
                <!-- interval provádění databázových kontrol v rozmezí od 1 do 60 minut -->
                <Database-test-period>1</Database-test-period>
                
                <!-- čas počátku režimu nečinnosti ve formátu hh:mm -->
                <Dormant-mode-from></Dormant-mode-from>

                <!-- čas ukončení režimu nečinnosti ve formátu hh:mm -->
                <Dormant-mode-to></Dormant-mode-to>

                <!-- příznak provádění kontroly období klidu databáze nastaveného v administraci systému -->
                <Check-database-idle>true</Check-database-idle>

                <!-- maximální stáří událostí načítaných z databázové fronty v rozmezí od 1 do 365 dnů, nevyplnění tohoto parametru značí načítání bez ohledu na stáří události -->
                <Max-event-age>360</Max-event-age>

                <!-- příznak automatického zálohování logovacího souboru -->
                <Backup-log-file>true</Backup-log-file>

                <!-- interval zálohování logovacího souboru v rozmezí od 1 do 365 dnů -->
                <Backup-log-period>1</Backup-log-period>

                <!-- příznak zajištění automatického zálohování databázové fronty událostí -->
                <Backup-event-queue>false</Backup-event-queue>

                <!-- příznak zajištění automatického zálohování databázového žurnálu chyb -->
                <Backup-exception-log>false</Backup-exception-log>

                <!-- příznak vynucení zpracování prošlých naplánovaných událostí -->
                <Force-expired-events>true</Force-expired-events>

                <!-- příznak zajištění monitorování provozu služby -->
                <Service-monitoring>false</Service-monitoring>

                <!-- výchozí cesta pro ukládání odloženě generovaných sestav -->
                <Reporter-schedule-path>c:\tmp</Reporter-schedule-path>

                <!-- cesta k souboru pravidelně vytvářenému za běhu služby -->
                <Service-run-file></Service-run-file>

                <!-- cesta k souboru, jehož existence značí požadavek na ukončení běhu služby -->
                <Service-stop-file></Service-stop-file>

                <!-- cesta k souboru, jehož existence značí požadavek na restartování služby -->
                <Service-restart-file></Service-restart-file>

                <!-- příznak inicializace licenčního klíče pro SecureBlackbox při startu služby -->
                <Initialize-sbb-key>false</Initialize-sbb-key>

                <!-- příznak práce s tajemstvím prostřednictvím externího zdroje -->
                <Use-vault>false</Use-vault>

                <!-- identifikátor instance služby -->
                <Instance-id></Instance-id>
                
            </GSSZUD01>
            <All>
                <!-- výchozí databázový profil -->
                <Default-profile>local</Default-profile>
                <!--<Default-profile>ddevvam7</Default-profile>-->

                <!-- URL autorizační služby -->
                <Auth-service-url>https://localhost:1234/auth</Auth-service-url>
                <!--<Auth-service-url>https://localhost/488/aut04/aut04.svc</Auth-service-url>-->
                <!--<Auth-service-url>https://localhost/aut04/aut04.svc</Auth-service-url>-->

                <!-- URL alternativní autorizační služby -->
                <!--<Auth-service-url>soap.tcp://vento/Auth</Auth-service-url>-->

                <!-- typ autorizace do GINISu (jedna z hodnot ginis, windows, anonymous, public) -->
                <Auth-type>windows</Auth-type>

                <!-- příznak ověřování důvěry mezi aplikacemi autorizační službou -->
                <!--<Auth-service-trust>false</Auth-service-trust>-->

                <!-- kultura pro lokalizaci aplikace -->
                <!-- <Culture>cs-CZ</Culture> -->

                <!-- seznam povolených databázových profilů -->
                <!-- <Allowed-profiles></Allowed-profiles> -->

                <!-- příznak povinného zobrazení přihlašovacího dialogu -->
                <!-- <Force-login>true</Force-login> -->

                <!-- režim přihlášení (1=řádné přihlášení, 2=zástup, 3=kombinace řádného přihlášení a zástupu, 4=automatické přihlášení) -->
                <!-- <Default-rezim>1</Default-rezim> -->

                <!-- přednastavená url adresa pro odesílání chybových hlášení -->
                <!-- <Send-errors-to></Send-errors-to> -->

                <!-- způsob odesílání e-mailových zpráv (jedna z hodnot smtp, emapi nebo sbbsmtp) -->
                <Mail-method>smtp</Mail-method>

                <!-- adresa serveru pro odesílání e-mailových zpráv -->
                <Mail-server>exg.gordic.cz</Mail-server> 
                <!-- <Mail-server>192.168.0.10</Mail-server> -->
                <!-- <Mail-server>smtp.omegatech.cz</Mail-server> -->

                <!-- port serveru pro odesílání e-mailových zpráv -->
                <Mail-port>25</Mail-port> 

                <!-- přihlašovací jméno pro odesílání e-mailových zpráv -->
                <!-- <Mail-user></Mail-user> -->

                <!-- heslo pro odesílání e-mailových zpráv -->
                <!-- <Mail-password></Mail-password> -->

                <!-- adresa odesílatele e-mailových zpráv -->
                <!--<Mail-from>Avizace GINIS &lt;automat@ginis.zud&gt;</Mail-from>-->
                <Mail-from>jan_kuttich@gordic.cz</Mail-from>

                <!-- seznam adres příjemců e-mailových zpráv (adresy v seznamu musí být odděleny středníkem) -->
                <!-- <Mail-to></Mail-to> -->

                <!-- seznam adres příjemců kopie e-mailových zpráv (adresy v seznamu musí být odděleny středníkem) -->
                <!-- <Mail-cc>jan.kuttich@email.cz</Mail-cc> -->

                <!-- seznam adres příjemců skryté kopie e-mailových zpráv (adresy v seznamu musí být odděleny středníkem) -->
                <!-- <Mail-bcc></Mail-bcc> -->
                
                <!-- seznam adres, na které nesmí být odeslány žádné zprávy (adresy v seznamu musí být odděleny středníkem) -->
                <Mail-black-list></Mail-black-list>

                <!-- název profilu odesílatele e-mailových zpráv (hodnota default značí výchozí profil aktuálního uživatele) -->
                <!-- <Mail-profile></Mail-profile> -->

                <!-- název počítače odesílatele e-mailových zpráv -->
                <!-- <Mail-client></Mail-client> -->

                <!-- příznak použití předpony pro SMTP (true nebo false) -->
                <!-- <Mail-use-prefix>false</Mail-use-prefix> -->

                <!-- příznak použití dialogu pro extended MAPI (true nebo false) -->
                <!-- <Mail-use-dialog>false</Mail-use-dialog> -->

                <!-- maximální přípustná velikost zprávy v Bytech (hodnota menší než 1 značí neomezenou velikost)  -->
                <Mail-max-size>2000000</Mail-max-size>

                <!-- kódová stránka pro e-mailové zprávy -->
                <!-- <Mail-encoding>iso-8859-2</Mail-encoding> -->

                <!-- příznak generování požadavku na potvrzení přečtení mailu -->
                <Mail-confirm>false</Mail-confirm>

                <!-- nastavení aplikačního logu do souboru -->
                <!--<Log>
                    <Output-xml outputFile="c:\tmp\GSSZUD01.log.xml" incrementalWrite="true" autoFlush="true">
                        <Log-id-filter>
                            <Include use="Wildcard">*</Include>
                            <Exclude use="Wildcard">Gordic.Support.Database.GDbLog*</Exclude>
                        </Log-id-filter>
                        <Log-level-filter>
                            <Include>Error</Include>
                            <Include>Warning</Include>
                            <Include>Info</Include>
                            <Include>Verbose</Include>
                        </Log-level-filter>
                    </Output-xml>
                </Log>-->

                <!-- nastavení aplikačního logu do txt souboru -->
                <!--<Log><Output-txt outputFile="c:\tmp\GSSZUD01.log.txt" incrementalWrite="true" autoFlush="true"><Log-id-filter><Include use="RegExpression">GSSZUD01</Include></Log-id-filter></Output-txt></Log>-->

                <!-- nastavení aplikačního logu do souboru -->
                <!--<Log><Output-debug><Log-id-filter><Include use="RegExpression">GSSZUD01</Include></Log-id-filter></Output-debug></Log>-->
                
                <!-- nastavení aplikačního logu do systémového logu -->
                <!--<Log><Output-system><Log-id-filter><Include use="RegExpression">GSSZUD01</Include></Log-id-filter></Output-system></Log>--> 

                <!-- adresář pro dočasné soubory generátoru sestav -->
                <!-- <Reporter-temp-path>c:\temp</Reporter-temp-path> -->

                <!-- cesta pro umístění žurnálu generátoru sestav -->
                <!-- <Reporter-journal>c:\temp\reporter.log.txt</Reporter-journal> -->

                <!-- příznak kontroly společných Win32 knihoven při startu aplikace -->
                <Gin-presence-required>false</Gin-presence-required>

                <!-- příznak přítomnosti výpisu zásobníku v textu výjimek -->
                <!--<Exception-stack-trace>true</Exception-stack-trace>-->

                <!-- typ SMS brány (jedna z hodnot O2, TMobile, Vodafone, InfoKanal nebo Email) -->
                <Sms-gateway-type>Email</Sms-gateway-type>

                <!-- cílová adresa pro odeslání SMS prostřednictvím e-mailu. V adrese lze použít zástupné symbly {phone} pro telefonní číslo a {prefix} pro mezinárodní telefonní předvolbou (tj. např. sms{prefix}{phone}@gateway.org) -->
                <Sms-gateway-email-to>{phone}@noreplay.com</Sms-gateway-email-to>

                <!-- URL adresa SMS brány -->
                <!--<Sms-gateway-url>https://www.infokanal.cz/api/simple/sms/send</Sms-gateway-url>-->

                <!-- přihlašovací jméno pro přístup k SMS bráně -->
                <!--<Sms-gateway-user>sys</Sms-gateway-user>-->

                <!-- heslo pro přístup k SMS bráně -->
                <!--<Sms-gateway-password>1sy2s5</Sms-gateway-password>-->

                <!-- seznam telefonních čísel příjemců SMS zprávy -->
                <!--<Sms-to>606722486</Sms-to>-->

                <!-- mezinárodní telefonní předvolba -->
                <!--<Sms-number-prefix>+420</Sms-number-prefix>-->

                <!-- počet číslic telefonního čísla (bez mezinárodní telefonní předvolby) -->
                <!--<Sms-number-of-digits>9</Sms-number-of-digits>-->

                <!-- příznak zápisu výjimek do systémového aplikačního logu -->
                <!--<Use-event-log>true</Use-event-log>-->

            </All>
        </Ginis>
    </Gordic>
</configuration>
