<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Gordic" type="Gordic.General.GCfgSectionHandler, Gordic.General" />
  </configSections>
  <Gordic>
    <Ginis>
      <All>
        <Log>
          <Output-txt outputFile="C:\Temp\GSARAK01.txt" incrementalWrite="true" autoFlush="true">
            <Log-level-filter>
              <Include>Error</Include>
              <Include>Warning</Include>
              <Include>Verbose</Include>
            </Log-level-filter>
          </Output-txt>
        </Log>
        <Kzmu-api-log>true</Kzmu-api-log>
        <Kzmu-api-log-dir>c:\temp\RAK_WS_LOG</Kzmu-api-log-dir>
        <WsKzmu-log>true</WsKzmu-log>
        <WsKzmu-log-dir>c:\Temp\RAK_WSKZMU_LOG</WsKzmu-log-dir>
        <!--Zapnutí využití nového rozhraní pro automatizovanou konverzi z moci úřední z listinné do elektronické podoby-->
        <WsKzmuAut>true</WsKzmuAut>
        <Dpi-debug>false</Dpi-debug>
        <Dpi-aware>true</Dpi-aware>
        <Dpi-font-scale>false</Dpi-font-scale>
        <Dpi-form-scale>None</Dpi-form-scale>
        <Dpi-form-scale>Font</Dpi-form-scale>
        <Dpi-form-scale>Dpi</Dpi-form-scale>
        <!--Startup-debug>true</Startup-debug>
        <ReportTempPath>c:\temp</ReportTempPath>
        <Reporter-journal>C:\Temp\InterpreterLog.txt</Reporter-journal>
        <Reporter-journal-erase>true</Reporter-journal-erase>
        <ReporterUseSafeCall>yes</ReporterUseSafeCall>
        <Reporter-lock-clipboard>1</Reporter-lock-clipboard-->
      </All>
    </Ginis>
  </Gordic>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>